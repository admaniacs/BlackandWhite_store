<div class="bw-media-placeholder" style="position:relative;height:420px">
  {%- if section.settings.image -%}
    <img src="{{ section.settings.image | image_url: width: 2400 }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
  {%- else -%}
    watch hero — wrist shot on black · 2400×840
  {%- endif -%}
  <div style="position:absolute;left:24px;bottom:24px;color:#fff">
    <div class="bw-label-mono" style="color:#999">{{ collection.products_count }} references</div>
    <div class="bw-display" style="font-size:clamp(38px,7vw,76px);margin-top:8px">{{ section.settings.heading }}</div>
  </div>
</div>

<div class="bw-filter-tabs" style="display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#000;border-top:1px solid #000">
  <a href="{{ collection.url }}" style="background:#fff;padding:14px 16px;font:600 11px var(--font-ui);letter-spacing:.1em;text-transform:uppercase">All {{ collection.products_count }}</a>
  {%- for filter in collection.filters -%}
    {%- if filter.type == 'list' -%}
      {%- for value in filter.values limit: 3 -%}
        <a href="{{ value.url_to_add }}" style="background:#fff;padding:14px 16px;font:600 11px var(--font-ui);letter-spacing:.1em;text-transform:uppercase;{% if value.active %}background:#000;color:#fff{% endif %}">{{ value.label }}</a>
      {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Watches hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tell the time. Stop." },
    { "type": "image_picker", "id": "image", "label": "Hero image" }
  ],
  "presets": [{ "name": "Watches hero" }]
}
{% endschema %}
