<div class="bw-stat-grid">
  {%- for block in section.blocks -%}
    <div class="bw-stat-grid__item">
      <div class="bw-stat-grid__number">{{ block.settings.number }}</div>
      <div class="bw-label-mono" style="margin-top:4px">{{ block.settings.label }}</div>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "About stats",
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "0" },
        { "type": "text", "id": "label", "label": "Label" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "About stats",
      "blocks": [
        { "type": "stat", "settings": { "number": "119", "label": "Products, total" } },
        { "type": "stat", "settings": { "number": "2", "label": "Colours, forever" } },
        { "type": "stat", "settings": { "number": "0", "label": "Fake discounts" } }
      ]
    }
  ]
}
{% endschema %}
