<div class="bw-container" style="max-width:440px;padding-top:60px;padding-bottom:60px">
  <div class="bw-h2">{{ 'customer.register.title' | t }}</div>
  {%- form 'create_customer' -%}
    {{ form.errors | default_errors }}
    <div style="display:flex;flex-direction:column;gap:10px;margin-top:20px">
      <input type="text" name="customer[first_name]" class="bw-field" placeholder="{{ 'customer.register.first_name' | t }}" autocomplete="given-name">
      <input type="text" name="customer[last_name]" class="bw-field" placeholder="{{ 'customer.register.last_name' | t }}" autocomplete="family-name">
      <input type="email" name="customer[email]" class="bw-field" placeholder="{{ 'customer.register.email' | t }}" autocomplete="email" required>
      <input type="password" name="customer[password]" class="bw-field" placeholder="{{ 'customer.register.password' | t }}" autocomplete="new-password" required>
      <button type="submit" class="bw-btn bw-btn--block">{{ 'customer.register.submit' | t }}</button>
    </div>
  {%- endform -%}
</div>
