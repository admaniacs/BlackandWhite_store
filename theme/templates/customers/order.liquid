<div class="bw-account-layout">
  {%- render 'account-nav', active: 'orders' -%}

  <div style="padding:24px" class="bw-container">
    <div class="bw-h2">{{ order.name }}</div>
    <div class="bw-label-mono" style="margin-top:6px">{{ order.created_at | date: '%d %b %Y' }} · {{ order.fulfillment_status_label }}</div>

    <div style="border:1px solid #000;margin-top:20px">
      {%- for line_item in order.line_items -%}
        <div class="bw-order-card__line">
          <div class="bw-media-placeholder" style="width:58px;height:74px;flex:none">
            {%- if line_item.image -%}<img src="{{ line_item.image | image_url: width: 120 }}" alt="{{ line_item.title | escape }}" loading="lazy">{%- endif -%}
          </div>
          <div style="flex:1">
            <div style="font:600 13px var(--font-ui);text-transform:uppercase">{{ line_item.title }}</div>
            <div class="bw-label-mono" style="margin-top:4px">Qty {{ line_item.quantity }}</div>
          </div>
          <span style="font:700 13px var(--font-ui);align-self:center">{{ line_item.final_line_price | money }}</span>
        </div>
      {%- endfor -%}
      <div style="padding:16px 14px">
        <div class="bw-summary-row"><span>Subtotal</span><span>{{ order.subtotal_price | money }}</span></div>
        <div class="bw-summary-row"><span>Shipping</span><span>{{ order.shipping_price | money }}</span></div>
        <div class="bw-summary-total"><span class="bw-h3" style="font-size:18px">Total</span><span style="font:700 20px var(--font-ui)">{{ order.total_price | money }}</span></div>
      </div>
    </div>

    <div style="margin-top:20px">
      <div class="bw-label-mono" style="margin-bottom:6px">Shipping address</div>
      <p class="bw-body">{{ order.shipping_address | format_address }}</p>
    </div>
  </div>
</div>
