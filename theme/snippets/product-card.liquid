{%- comment -%}
  Accepts: product, show_sizes (bool), quick_add (bool)
{%- endcomment -%}
{%- assign is_new = false -%}
{%- if product.tags contains 'new' -%}{%- assign is_new = true -%}{%- endif -%}
<div class="bw-product-card" data-product-card>
  <div class="bw-media-placeholder bw-product-card__media" style="position:relative">
    <a href="{{ product.url }}" style="position:absolute;inset:0">
      {%- if product.featured_image -%}
        <img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy">
      {%- else -%}
        {{ product.title | slice: 0, 1 }}
      {%- endif -%}
    </a>
    {%- if is_new -%}<span class="bw-badge">New</span>{%- endif -%}
    {%- if quick_add -%}
      <button type="button" class="bw-product-card__quickadd" data-quick-add data-variant-id="{{ product.selected_or_first_available_variant.id }}" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
        {%- if product.selected_or_first_available_variant.available -%}{{ 'products.product.quick_add' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
      </button>
    {%- endif -%}
  </div>
  <a href="{{ product.url }}" class="bw-product-card__body">
    <span class="bw-product-card__title">{{ product.title }}</span>
    <span class="bw-price">{{ product.price | money_without_trailing_zeros }}</span>
  </a>
  {%- if show_sizes -%}
    <div class="bw-product-card__sizes">
      {%- for variant in product.variants limit: 4 -%}
        <span class="bw-size-chip{% if variant.selected %} is-selected{% endif %}{% unless variant.available %} is-disabled{% endunless %}">{{ variant.title | split: ' / ' | last }}</span>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
