[
  {
    "name": "theme_info",
    "theme_name": "B/W",
    "theme_version": "1.0.0",
    "theme_author": "B/W Store",
    "theme_documentation_url": "https://github.com/admaniacs/BlackandWhite_store",
    "theme_support_email": "tech@admaniacs.io"
  },
  {
    "name": "Logo and favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_height",
        "label": "Desktop logo height",
        "min": 12,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 36
      },
      {
        "type": "range",
        "id": "logo_height_mobile",
        "label": "Mobile logo height",
        "min": 12,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 28
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "paragraph",
        "content": "Define named color schemes here. Every section can then pick one from a dropdown — change a scheme once and every section using it updates together."
      },
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          { "type": "color", "id": "background", "label": "Background", "default": "#FFFFFF" },
          { "type": "color_background", "id": "background_gradient", "label": "Background gradient", "info": "Overrides the background color when set." },
          { "type": "color", "id": "text", "label": "Text", "default": "#000000" },
          { "type": "color", "id": "button", "label": "Button background", "default": "#000000" },
          { "type": "color", "id": "button_label", "label": "Button label", "default": "#FFFFFF" },
          { "type": "color", "id": "secondary_button_label", "label": "Secondary button / borders / links", "default": "#000000" },
          { "type": "color", "id": "shadow", "label": "Shadow", "default": "#000000" }
        ],
        "role": {
          "text": "text",
          "background": { "solid": "background", "gradient": "background_gradient" },
          "links": "secondary_button_label",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "secondary_button_label",
          "secondary_button_border": "secondary_button_label"
        }
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Heading font",
        "default": "archivo_black_n4",
        "info": "Used for all large uppercase headings."
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body text font",
        "default": "archivo_n4",
        "info": "Used for navigation, buttons, prices and body text."
      },
      {
        "type": "font_picker",
        "id": "type_mono_font",
        "label": "Label font",
        "default": "ibm_plex_mono_n4",
        "info": "Used for small uppercase labels, such as tags and breadcrumbs."
      },
      {
        "type": "select",
        "id": "heading_case",
        "label": "Heading case",
        "options": [
          { "value": "uppercase", "label": "Uppercase" },
          { "value": "none", "label": "Normal case" }
        ],
        "default": "uppercase",
        "info": "Applies to large display headings (bw-display / bw-h2 / bw-h3), not nav or meta labels."
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Heading size scale",
        "min": 85,
        "max": 120,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Announcement bar",
    "settings": [
      {
        "type": "text",
        "id": "announcement_message",
        "label": "Marquee message",
        "default": "FREE SHIPPING OVER $75 · 30-DAY RETURNS · NEW DROP FRIDAY 9AM"
      },
      {
        "type": "checkbox",
        "id": "announcement_enable",
        "label": "Show announcement bar",
        "default": true
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold ($)",
        "default": 75
      },
      {
        "type": "product",
        "id": "cart_upsell_product",
        "label": "Cart drawer upsell product"
      }
    ]
  },
  {
    "name": "Social",
    "settings": [
      { "type": "paragraph", "content": "Leave any of these blank to hide that icon. They appear everywhere social icons are shown (footer, password page)." },
      { "type": "url", "id": "social_instagram", "label": "Instagram" },
      { "type": "url", "id": "social_tiktok", "label": "TikTok" },
      { "type": "url", "id": "social_facebook", "label": "Facebook" },
      { "type": "url", "id": "social_twitter", "label": "X (Twitter)" },
      { "type": "url", "id": "social_pinterest", "label": "Pinterest" },
      { "type": "url", "id": "social_youtube", "label": "YouTube" },
      { "type": "url", "id": "social_snapchat", "label": "Snapchat" },
      { "type": "url", "id": "social_linkedin", "label": "LinkedIn" },
      { "type": "url", "id": "social_tumblr", "label": "Tumblr" },
      { "type": "url", "id": "social_vimeo", "label": "Vimeo" },
      { "type": "url", "id": "social_threads", "label": "Threads" }
    ]
  },
  {
    "name": "Cursor",
    "settings": [
      {
        "type": "checkbox",
        "id": "custom_cursor_enabled",
        "label": "Enable custom cursor",
        "default": true,
        "info": "Replaces the pointer with a trailing circle that inverts the colors beneath it. Desktop only — touch devices are unaffected."
      },
      {
        "type": "range",
        "id": "custom_cursor_size",
        "label": "Cursor size",
        "min": 16,
        "max": 44,
        "step": 2,
        "unit": "px",
        "default": 28
      }
    ]
  }
]
