<div class="bw-container" style="max-width:440px;padding-top:60px;padding-bottom:60px">
  <div class="bw-h2">{{ 'customer.activate_account.title' | t }}</div>
  <p class="bw-body" style="margin-top:10px">{{ 'customer.activate_account.subtext' | t }}</p>
  {%- form 'activate_customer_password' -%}
    {{ form.errors | default_errors }}
    <div style="display:flex;flex-direction:column;gap:10px;margin-top:20px">
      <label class="bw-visually-hidden" for="ActivateAccountCustomerPassword">{{ 'customer.activate_account.password' | t }}</label>
      <input id="ActivateAccountCustomerPassword" type="password" name="customer[password]" class="bw-field" placeholder="{{ 'customer.activate_account.password' | t }}" autocomplete="new-password" required>
      <label class="bw-visually-hidden" for="ActivateAccountCustomerPasswordConfirmation">{{ 'customer.activate_account.password_confirm' | t }}</label>
      <input id="ActivateAccountCustomerPasswordConfirmation" type="password" name="customer[password_confirmation]" class="bw-field" placeholder="{{ 'customer.activate_account.password_confirm' | t }}" autocomplete="new-password" required>
      <button type="submit" class="bw-btn bw-btn--block">{{ 'customer.activate_account.submit' | t }}</button>
      <button type="submit" name="decline" class="bw-btn bw-btn--outline bw-btn--block">{{ 'customer.activate_account.decline' | t }}</button>
    </div>
  {%- endform -%}
</div>
