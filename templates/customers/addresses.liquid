<div class="bw-account-layout">
  {%- render 'account-nav', active: 'addresses' -%}

  <div style="padding:24px" class="bw-container">
    <div class="bw-h2">{{ 'customer.account.addresses' | t }}</div>

    {%- if customer.addresses.size == 0 -%}
      <p class="bw-body" style="margin-top:18px">No saved addresses yet.</p>
    {%- else -%}
      <div class="bw-grid bw-grid--3" style="margin-top:18px">
        {%- for address in customer.addresses -%}
          <div class="bw-spec-cell" style="border:1px solid #000;padding:16px">
            <p class="bw-body" style="color:#000">{{ address | format_address }}</p>
            {%- if address == customer.default_address -%}
              <div class="bw-label-mono" style="margin-top:8px">Default</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- form 'customer_address', customer.new_address, class: 'bw-address-form' -%}
      <div class="bw-h3" style="margin-top:30px;font-size:18px">Add a new address</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px;max-width:520px">
        <label class="bw-visually-hidden" for="AddressesAddressFirstName">First name</label>
        <input id="AddressesAddressFirstName" type="text" class="bw-field" name="address[first_name]" placeholder="First name">
        <label class="bw-visually-hidden" for="AddressesAddressLastName">Last name</label>
        <input id="AddressesAddressLastName" type="text" class="bw-field" name="address[last_name]" placeholder="Last name">
        <label class="bw-visually-hidden" for="AddressesAddressAddress1">Address</label>
        <input id="AddressesAddressAddress1" type="text" class="bw-field" style="grid-column:span 2" name="address[address1]" placeholder="Address">
        <label class="bw-visually-hidden" for="AddressesAddressCity">City</label>
        <input id="AddressesAddressCity" type="text" class="bw-field" name="address[city]" placeholder="City">
        <label class="bw-visually-hidden" for="AddressesAddressZip">Postal / ZIP code</label>
        <input id="AddressesAddressZip" type="text" class="bw-field" name="address[zip]" placeholder="Postal / ZIP code">
        <label class="bw-visually-hidden" for="AddressesAddressCountry">Country</label>
        <input id="AddressesAddressCountry" type="text" class="bw-field" name="address[country]" placeholder="Country">
        <label class="bw-visually-hidden" for="AddressesAddressPhone">Phone</label>
        <input id="AddressesAddressPhone" type="text" class="bw-field" name="address[phone]" placeholder="Phone">
      </div>
      <button type="submit" class="bw-btn" style="margin-top:16px">Save address</button>
    {%- endform -%}
  </div>
</div>
