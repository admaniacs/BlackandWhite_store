<div class="bw-container" style="max-width:440px;padding-top:60px;padding-bottom:60px">
  <div id="login" data-login-screen>
    <div class="bw-h2">{{ 'customer.login.title' | t }}</div>
    {%- form 'customer_login' -%}
      {{ form.errors | default_errors }}
      <div style="display:flex;flex-direction:column;gap:10px;margin-top:20px">
        <input type="email" name="customer[email]" class="bw-field" placeholder="{{ 'customer.login.email' | t }}" autocomplete="email" required>
        {%- if form.password_needed -%}
          <input type="password" name="customer[password]" class="bw-field" placeholder="{{ 'customer.login.password' | t }}" autocomplete="current-password" required>
        {%- endif -%}
        <button type="submit" class="bw-btn bw-btn--block">{{ 'customer.login.sign_in' | t }}</button>
      </div>
    {%- endform -%}
    <div style="display:flex;justify-content:space-between;margin-top:16px" class="bw-label-mono">
      <a href="#recover" data-recover-open style="text-decoration:underline">{{ 'customer.login.forgot_password' | t }}</a>
      <a href="{{ routes.account_register_url }}" style="text-decoration:underline">{{ 'customer.login.create_account' | t }}</a>
    </div>
  </div>

  {%- assign posted_to_recover = false -%}
  <div id="recover" data-recover-screen hidden>
    <div class="bw-h2">{{ 'customer.login.recover_title' | t }}</div>
    {%- form 'recover_customer_password' -%}
      {%- if form.posted_successfully? or form.errors -%}{%- assign posted_to_recover = true -%}{%- endif -%}
      {%- if form.posted_successfully? -%}
        <p class="bw-body" style="margin-top:16px">{{ 'customer.login.recover_success' | t }}</p>
      {%- else -%}
        {{ form.errors | default_errors }}
        <p class="bw-body" style="margin-top:16px">{{ 'customer.login.recover_subtext' | t }}</p>
        <div style="display:flex;flex-direction:column;gap:10px;margin-top:16px">
          <input type="email" name="email" class="bw-field" placeholder="{{ 'customer.login.email' | t }}" autocomplete="email" required>
          <button type="submit" class="bw-btn bw-btn--block">{{ 'customer.login.recover_submit' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
    <div style="margin-top:16px" class="bw-label-mono">
      <a href="#login" data-recover-close style="text-decoration:underline">{{ 'customer.login.back_to_sign_in' | t }}</a>
    </div>
  </div>
</div>

<script>
  (function () {
    var login = document.querySelector('[data-login-screen]');
    var recover = document.querySelector('[data-recover-screen]');
    if (!login || !recover) return;
    function showRecover() { login.hidden = true; recover.hidden = false; }
    function showLogin() { recover.hidden = true; login.hidden = false; }
    document.querySelectorAll('[data-recover-open]').forEach(function (el) { el.addEventListener('click', showRecover); });
    document.querySelectorAll('[data-recover-close]').forEach(function (el) { el.addEventListener('click', showLogin); });
    if (window.location.hash === '#recover'{% if posted_to_recover %} || true{% endif %}) { showRecover(); }
  })();
</script>
