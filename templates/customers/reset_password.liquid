<div class="bw-container" style="max-width:440px;padding-top:60px;padding-bottom:60px">
  <div class="bw-h2">{{ 'customer.reset_password.title' | t }}</div>
  <p class="bw-body" style="margin-top:10px">{{ 'customer.reset_password.subtext' | t: email: email }}</p>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <div style="display:flex;flex-direction:column;gap:10px;margin-top:20px">
      <input type="password" name="customer[password]" class="bw-field" placeholder="{{ 'customer.reset_password.password' | t }}" autocomplete="new-password" required>
      <input type="password" name="customer[password_confirmation]" class="bw-field" placeholder="{{ 'customer.reset_password.password_confirm' | t }}" autocomplete="new-password" required>
      <button type="submit" class="bw-btn bw-btn--block">{{ 'customer.reset_password.submit' | t }}</button>
    </div>
  {%- endform -%}
</div>
