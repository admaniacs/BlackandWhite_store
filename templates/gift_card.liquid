{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }} — {{ 'gift_cards.issued.title' | t }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Archivo+Black&display=swap" rel="stylesheet">
  {{ content_for_header }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ 'vendor/qrcode.js' | shopify_asset_url | script_tag }}
  <style>
    @media print {
      .bw-gift-card__no-print { display: none; }
    }
  </style>
</head>
<body>
  <div class="bw-gift-card">
    <div class="bw-header__logo" style="font-size:26px">
      {%- if settings.logo != blank -%}
        <img src="{{ settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}" style="height:36px;width:auto;display:block;margin:0 auto" loading="eager">
      {%- else -%}
        {{ shop.name | default: 'B/W' }}
      {%- endif -%}
    </div>

    <div class="bw-label-mono">{{ 'gift_cards.issued.title' | t }}</div>

    <div class="bw-gift-card__balance">{{ gift_card.balance | money }}</div>

    {%- if gift_card.enabled and gift_card.expired == false -%}
      {%- assign gift_card_value = gift_card.initial_value | money -%}
      <p class="bw-body">{{ 'gift_cards.issued.subtext' | t: value: gift_card_value, shop: shop.name }}</p>
    {%- elsif gift_card.expired -%}
      <p class="bw-body">{{ 'gift_cards.issued.expired' | t: expiry: gift_card.expires_on }}</p>
    {%- else -%}
      <p class="bw-body">{{ 'gift_cards.issued.disabled' | t }}</p>
    {%- endif -%}

    <div class="bw-gift-card__code">{{ gift_card.code | format_code }}</div>
    <p class="bw-label-mono">{{ 'gift_cards.issued.how_to_redeem' | t }}</p>

    <div id="qr-code"></div>
    <script>
      new QRCode(document.getElementById('qr-code'), {
        text: {{ gift_card.qr_identifier | json }},
        width: 120,
        height: 120
      });
    </script>

    {%- if gift_card.pass_url -%}
      <a href="{{ gift_card.pass_url }}" class="bw-nav-link" style="text-decoration:underline">{{ 'gift_cards.issued.add_to_apple_wallet' | t }}</a>
    {%- endif -%}

    <div class="bw-gift-card__no-print" style="display:flex;gap:12px;margin-top:10px">
      <button type="button" class="bw-btn bw-btn--outline" onclick="window.print()">{{ 'gift_cards.issued.print' | t }}</button>
      <a href="{{ shop.url }}" class="bw-btn">{{ 'gift_cards.issued.shop_link' | t }}</a>
    </div>
  </div>
</body>
</html>
