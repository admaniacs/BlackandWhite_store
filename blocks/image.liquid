<div {{ block.shopify_attributes }} style="width:{{ block.settings.width }}%;max-width:100%;margin:0 {% if block.settings.width < 100 %}auto{% else %}0{% endif %}">
  {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
  <div class="bw-media-placeholder" style="aspect-ratio:{{ block.settings.aspect_ratio }}">
    {%- if block.settings.image -%}
      <img src="{{ block.settings.image | image_url: width: 1600 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" style="width:100%;height:100%;object-fit:cover">
    {%- else -%}
      image
    {%- endif -%}
  </div>
  {%- if block.settings.link != blank -%}</a>{%- endif -%}
</div>

{% schema %}
{
  "name": "Image",
  "tag": null,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "range", "id": "width", "label": "Width", "min": 20, "max": 100, "step": 5, "unit": "%", "default": 100 },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Aspect ratio",
      "options": [
        { "value": "1/1", "label": "Square" },
        { "value": "4/3", "label": "Landscape" },
        { "value": "3/4", "label": "Portrait" },
        { "value": "16/9", "label": "Wide" }
      ],
      "default": "4/3"
    }
  ],
  "presets": [{ "name": "Image" }]
}
{% endschema %}
