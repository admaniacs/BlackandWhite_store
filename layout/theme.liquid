<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <script>document.documentElement.classList.add('bw-js');</script>
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
  <title>{{ page_title }}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  {%- render 'meta-tags' -%}
  {{ content_for_header }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {%- if settings.color_schemes -%}
  <style>
    {%- for scheme in settings.color_schemes -%}
    .color-{{ scheme.id }} {
      --ink: {{ scheme.settings.text }};
      --paper: {{ scheme.settings.background }};
      --scheme-button-bg: {{ scheme.settings.button }};
      --scheme-button-text: {{ scheme.settings.button_label }};
      --scheme-secondary-text: {{ scheme.settings.secondary_button_label }};
      --scheme-shadow: {{ scheme.settings.shadow }};
      background: {{ scheme.settings.background_gradient | default: scheme.settings.background }};
      color: var(--ink);
    }
    {%- endfor -%}
  </style>
  {%- endif -%}
  {%- comment -%}
    Each font role loads its regular face plus bold, italic and bold-italic.
    Without these, a <strong> or <em> — in a blog post, a product description,
    anywhere a merchant writes — gets synthesised by the browser instead of the
    real cut, which looks noticeably wrong. font_modify returns nothing when a
    family has no such weight, so this degrades quietly on single-weight fonts.
  {%- endcomment -%}
  {%- liquid
    assign heading_bold = settings.type_heading_font | font_modify: 'weight', 'bolder'
    assign heading_italic = settings.type_heading_font | font_modify: 'style', 'italic'
    assign heading_bold_italic = heading_bold | font_modify: 'style', 'italic'
    assign body_bold = settings.type_body_font | font_modify: 'weight', 'bolder'
    assign body_italic = settings.type_body_font | font_modify: 'style', 'italic'
    assign body_bold_italic = body_bold | font_modify: 'style', 'italic'
    assign mono_bold = settings.type_mono_font | font_modify: 'weight', 'bolder'
    assign mono_italic = settings.type_mono_font | font_modify: 'style', 'italic'
    assign mono_bold_italic = mono_bold | font_modify: 'style', 'italic'
  -%}
  <style>
    {{ settings.type_heading_font | font_face: font_display: 'swap' }}
    {{ heading_bold | font_face: font_display: 'swap' }}
    {{ heading_italic | font_face: font_display: 'swap' }}
    {{ heading_bold_italic | font_face: font_display: 'swap' }}
    {{ settings.type_body_font | font_face: font_display: 'swap' }}
    {{ body_bold | font_face: font_display: 'swap' }}
    {{ body_italic | font_face: font_display: 'swap' }}
    {{ body_bold_italic | font_face: font_display: 'swap' }}
    {{ settings.type_mono_font | font_face: font_display: 'swap' }}
    {{ mono_bold | font_face: font_display: 'swap' }}
    {{ mono_italic | font_face: font_display: 'swap' }}
    {{ mono_bold_italic | font_face: font_display: 'swap' }}
    :root {
      --font-display: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
      --font-ui: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
      --font-mono: {{ settings.type_mono_font.family }}, {{ settings.type_mono_font.fallback_families }};
      --heading-transform: {{ settings.heading_case | default: 'uppercase' }};
      --heading-scale: {{ settings.heading_scale | default: 100 | times: 1.0 | divided_by: 100 }};
    }
  </style>
</head>
<body class="bw-body-{{ request.page_type }}" data-custom-cursor="{{ settings.custom_cursor_enabled }}" style="--bw-cursor-size: {{ settings.custom_cursor_size | default: 28 }}px">
  <a class="bw-visually-hidden" href="#bw-main">Skip to content</a>

  {%- unless request.page_type == 'password' -%}{% sections 'header-group' %}{%- endunless -%}

  <main id="bw-main">
    {{ content_for_layout }}
  </main>

  {%- unless request.page_type == 'password' -%}
    {% sections 'footer-group' %}
    {% section 'cart-drawer' %}
    {% render 'search-overlay' %}
  {%- endunless -%}

  {%- render 'structured-data' -%}
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
