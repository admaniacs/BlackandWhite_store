<div class="color-{{ section.settings.color_scheme }}" style="background:var(--paper);color:var(--ink);padding:{{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;text-align:center">
  <div class="bw-container" style="padding:0">
    <div class="bw-label-mono">{{ section.settings.eyebrow }}</div>
    <div class="bw-display" style="font-size:clamp(48px,10vw,100px);margin-top:14px">{{ section.settings.heading }}</div>
    <p style="font:16px/1.55 var(--font-ui);color:#999;max-width:480px;margin:20px auto 0">{{ section.settings.body }}</p>

    <form action="{{ routes.search_url }}" method="get" role="search" style="display:flex;gap:8px;max-width:420px;margin:28px auto 0">
      <input type="search" name="q" class="bw-field" placeholder="{{ 'general.search.placeholder' | t }}">
      <input type="hidden" name="type" value="product">
      <button type="submit" class="bw-btn">{{ 'general.search.placeholder' | t }}</button>
    </form>

    <a href="{{ routes.root_url }}" class="bw-nav-link" style="display:inline-block;margin-top:24px;text-decoration:underline;color:var(--ink)">{{ section.settings.back_link_text }} →</a>
  </div>
</div>

{% schema %}
{
  "name": "404 page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "404" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Nothing here." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "That page doesn't exist, moved, or was never here. Two colours, zero broken links — usually." },
    { "type": "text", "id": "back_link_text", "label": "Back link label", "default": "Back to shop" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 40, "max": 200, "step": 8, "unit": "px", "default": 100 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 40, "max": 200, "step": 8, "unit": "px", "default": 100 },
    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" }
  ]
}
{% endschema %}
