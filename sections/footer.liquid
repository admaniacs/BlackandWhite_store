<footer class="bw-footer color-{{ section.settings.color_scheme }}" style="position:relative;padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  {%- render 'section-media-background', image: section.settings.background_image, video: section.settings.background_video, overlay_opacity: section.settings.background_overlay_opacity -%}
  <div class="bw-footer__grid" style="position:relative">
    <div>
      <div class="bw-header__logo" style="font-size:30px">
        {%- if section.settings.show_logo and settings.logo != blank -%}
          <img src="{{ settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}" style="height:{{ section.settings.logo_height }}px;width:auto;display:block;{% if section.settings.invert_logo %}filter:invert(1);{% endif %}" loading="lazy">
        {%- else -%}
          {{ shop.name | default: 'B/W' }}
        {%- endif -%}
      </div>
      <p style="font:13px/1.5 var(--font-ui);color:#aaa;max-width:260px;margin:8px 0 14px">{{ section.settings.tagline }}</p>
      {%- if section.settings.show_newsletter -%}
        {%- form 'customer', id: 'footer-newsletter' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="bw-footer__signup">
            <input type="email" name="contact[email]" placeholder="email address" required aria-label="Email address">
            <button type="submit">Join</button>
          </div>
        {%- endform -%}
      {%- endif -%}
      {%- if section.settings.show_social_icons -%}
        {%- if settings.social_instagram != blank or settings.social_tiktok != blank or settings.social_facebook != blank or settings.social_twitter != blank or settings.social_pinterest != blank or settings.social_youtube != blank or settings.social_snapchat != blank or settings.social_linkedin != blank or settings.social_tumblr != blank or settings.social_vimeo != blank or settings.social_threads != blank -%}
          <div class="bw-footer__social">
            {%- if settings.social_instagram != blank -%}
              <a href="{{ settings.social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener">{%- render 'icon-instagram' -%}</a>
            {%- endif -%}
            {%- if settings.social_tiktok != blank -%}
              <a href="{{ settings.social_tiktok }}" aria-label="TikTok" target="_blank" rel="noopener">{%- render 'icon-tiktok' -%}</a>
            {%- endif -%}
            {%- if settings.social_facebook != blank -%}
              <a href="{{ settings.social_facebook }}" aria-label="Facebook" target="_blank" rel="noopener">{%- render 'icon-facebook' -%}</a>
            {%- endif -%}
            {%- if settings.social_twitter != blank -%}
              <a href="{{ settings.social_twitter }}" aria-label="X (Twitter)" target="_blank" rel="noopener">{%- render 'icon-twitter' -%}</a>
            {%- endif -%}
            {%- if settings.social_pinterest != blank -%}
              <a href="{{ settings.social_pinterest }}" aria-label="Pinterest" target="_blank" rel="noopener">{%- render 'icon-pinterest' -%}</a>
            {%- endif -%}
            {%- if settings.social_youtube != blank -%}
              <a href="{{ settings.social_youtube }}" aria-label="YouTube" target="_blank" rel="noopener">{%- render 'icon-youtube' -%}</a>
            {%- endif -%}
            {%- if settings.social_snapchat != blank -%}
              <a href="{{ settings.social_snapchat }}" aria-label="Snapchat" target="_blank" rel="noopener">{%- render 'icon-snapchat' -%}</a>
            {%- endif -%}
            {%- if settings.social_linkedin != blank -%}
              <a href="{{ settings.social_linkedin }}" aria-label="LinkedIn" target="_blank" rel="noopener">{%- render 'icon-linkedin' -%}</a>
            {%- endif -%}
            {%- if settings.social_tumblr != blank -%}
              <a href="{{ settings.social_tumblr }}" aria-label="Tumblr" target="_blank" rel="noopener">{%- render 'icon-tumblr' -%}</a>
            {%- endif -%}
            {%- if settings.social_vimeo != blank -%}
              <a href="{{ settings.social_vimeo }}" aria-label="Vimeo" target="_blank" rel="noopener">{%- render 'icon-vimeo' -%}</a>
            {%- endif -%}
            {%- if settings.social_threads != blank -%}
              <a href="{{ settings.social_threads }}" aria-label="Threads" target="_blank" rel="noopener">{%- render 'icon-threads' -%}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      <div class="bw-footer__col" {{ block.shopify_attributes }}>
        <span class="bw-footer__col-title">{{ block.settings.title }}</span>
        {%- if block.settings.menu != blank -%}
          {%- for link in linklists[block.settings.menu].links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  {%- if section.settings.show_copyright or shop.policies.size > 0 or section.settings.show_payment_icons -%}
    <div class="bw-footer__bottom" style="position:relative">
      <div class="bw-footer__legal">
        {%- if section.settings.show_copyright -%}
          <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
        {%- endif -%}
        {%- for policy in shop.policies -%}
          <a href="{{ policy.url }}">{{ policy.title }}</a>
        {%- endfor -%}
      </div>
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="bw-footer__payment-icons" aria-label="Payment methods">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'bw-footer__payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  {%- endif -%}
</footer>

{% schema %}
{
  "name": "Footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "Show logo instead of store name",
      "default": true,
      "info": "Uses the logo uploaded in Theme settings → Logo and favicon."
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 30,
      "visible_if": "{{ section.settings.show_logo }}"
    },
    {
      "type": "checkbox",
      "id": "invert_logo",
      "label": "Invert logo colors",
      "default": true,
      "info": "Turns a dark logo white so it stays visible on a dark footer background.",
      "visible_if": "{{ section.settings.show_logo }}"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Two colours, done properly. Join the list for drop alerts."
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show email signup",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_social_icons",
      "label": "Show social icons",
      "default": true,
      "info": "Add your links under Theme settings → Social."
    },
    { "type": "header", "content": "Legal & trust" },
    {
      "type": "checkbox",
      "id": "show_copyright",
      "label": "Show copyright line",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show accepted payment icons",
      "default": true
    },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "header", "content": "Background image or video" },
    { "type": "image_picker", "id": "background_image", "label": "Background image", "info": "Used when no background video is set." },
    { "type": "video", "id": "background_video", "label": "Background video", "info": "Takes priority over the background image." },
    { "type": "range", "id": "background_overlay_opacity", "label": "Darkening overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 0 }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "title", "label": "Column title", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "info": "Pick a menu from Online Store → Navigation. Its links are shown in this column." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "link_column", "settings": { "title": "Shop", "menu": "main-menu" } },
      { "type": "link_column", "settings": { "title": "Help" } },
      { "type": "link_column", "settings": { "title": "B/W" } }
    ]
  }
}
{% endschema %}
