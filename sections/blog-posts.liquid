{%- assign posts_blog = blogs[section.settings.blog] -%}
<div class="color-{{ section.settings.color_scheme }}" style="background:var(--paper);color:var(--ink);padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="bw-container">
    <div style="display:flex;align-items:baseline;justify-content:space-between;padding-bottom:16px;flex-wrap:wrap;gap:10px">
      <h2 class="bw-h2">{{ section.settings.heading }}</h2>
      {%- if posts_blog != blank -%}
        <a href="{{ posts_blog.url }}" class="bw-nav-link">{{ section.settings.view_all_label }} →</a>
      {%- endif -%}
    </div>

    {%- if posts_blog != blank and posts_blog.articles.size > 0 -%}
      <div class="bw-grid bw-grid--3">
        {%- for article in posts_blog.articles limit: section.settings.posts_to_show -%}
          <a href="{{ article.url }}" class="bw-blog-card">
            <div class="bw-media-placeholder bw-blog-card__media">
              {%- if article.image -%}
                <img src="{{ article.image | image_url: width: 900 }}" alt="{{ article.image.alt | escape }}" loading="lazy">
              {%- else -%}article · 900×600{%- endif -%}
            </div>
            <div class="bw-blog-card__body">
              {%- if section.settings.show_date or section.settings.show_author -%}
                <div class="bw-label-mono">
                  {%- if section.settings.show_date -%}{{ article.published_at | date: '%B %d, %Y' }}{%- endif -%}
                  {%- if section.settings.show_date and section.settings.show_author -%} · {%- endif -%}
                  {%- if section.settings.show_author -%}{{ 'blogs.article.by_author' | t: author: article.author }}{%- endif -%}
                </div>
              {%- endif -%}
              <div class="bw-blog-card__title">{{ article.title }}</div>
              {%- if section.settings.show_excerpt -%}
                <p class="bw-blog-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
              {%- endif -%}
              <span class="bw-nav-link" style="text-decoration:underline">{{ 'blogs.article.read_more' | t }} →</span>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <div class="bw-empty-state">
        <p class="bw-label-mono">Pick a blog in the section settings to show its posts here.</p>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Blog posts",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the journal" },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "posts_to_show", "label": "Posts to show", "min": 2, "max": 6, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true },
    { "type": "checkbox", "id": "show_author", "label": "Show author", "default": false },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpt", "default": true },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "presets": [{ "name": "Blog posts" }]
}
{% endschema %}
