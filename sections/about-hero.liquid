<div class="color-{{ section.settings.color_scheme }}" style="background:var(--paper);color:var(--ink);padding:52px 24px;padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;position:relative;overflow:hidden;text-align:{{ section.settings.text_alignment }}">
  {%- render 'section-media-background', image: section.settings.background_image, video: section.settings.background_video, overlay_opacity: section.settings.background_overlay_opacity -%}
  <div class="bw-container" style="padding:0;position:relative">
    <div class="bw-display" style="font-size:calc(var(--heading-scale) * clamp(44px,9vw,92px))">{{ section.settings.heading }}</div>
    <p style="font:16px/1.55 var(--font-ui);color:#bbb;max-width:520px;margin:24px 0 0{% if section.settings.text_alignment == 'center' %};margin-left:auto;margin-right:auto{% endif %}">{{ section.settings.body }}</p>
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "About hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "We deleted the colour chart." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "B/W started because getting dressed shouldn't be a decision. Two colours, heavy fabric, prices that don't need a sale to look reasonable." },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "left" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 52 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 52 },
    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "header", "content": "Background image or video" },
    { "type": "image_picker", "id": "background_image", "label": "Background image", "info": "Used when no background video is set." },
    { "type": "video", "id": "background_video", "label": "Background video", "info": "Takes priority over the background image." },
    { "type": "range", "id": "background_overlay_opacity", "label": "Darkening overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 0 }
  ],
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "presets": [{ "name": "About hero" }]
}
{% endschema %}
