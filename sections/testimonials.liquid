{%- if section.blocks.size > 0 or request.design_mode -%}
<div class="color-{{ section.settings.color_scheme }}" style="background:var(--paper);color:var(--ink);padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="bw-container">
    {%- if section.blocks.size > 0 -%}
      {%- if section.settings.heading != blank -%}
        <div class="bw-h2" style="text-align:{{ section.settings.text_alignment }};margin-bottom:24px">{{ section.settings.heading }}</div>
      {%- endif -%}
      <div class="bw-grid bw-grid--3">
        {%- for block in section.blocks -%}
          <div class="bw-review-card" {{ block.shopify_attributes }}>
            {%- if block.settings.rating > 0 -%}
              <div class="bw-review-card__stars">{% render 'star-rating', rating: block.settings.rating %}</div>
            {%- endif -%}
            <p class="bw-review-card__body" style="margin-top:8px">{{ block.settings.quote }}</p>
            <div class="bw-review-card__meta">{{ block.settings.author }}{% if block.settings.role != blank %} · {{ block.settings.role }}{% endif %}</div>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="bw-empty-state">
        <p class="bw-label-mono">Add testimonials to this section from the theme editor.</p>
      </div>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Testimonials",
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 0, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Doesn't go see-through after two washes. Bought the white one next day." },
        { "type": "text", "id": "author", "label": "Author", "default": "Dani R." },
        { "type": "text", "id": "role", "label": "Role / context", "default": "Verified buyer" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What people say" },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "text_alignment", "label": "Heading alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "left" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial", "settings": { "quote": "Sized down and it's perfect. Sleeves run a touch long.", "author": "Marc T.", "rating": 4 } },
        { "type": "testimonial", "settings": { "quote": "Better than pieces I've paid triple for. Shipping was two days.", "author": "Ify A." } }
      ]
    }
  ]
}
{% endschema %}
