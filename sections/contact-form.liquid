<div class="color-{{ section.settings.color_scheme }}" style="background:var(--paper);color:var(--ink);padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="bw-container" style="max-width:560px">
    <h2 class="bw-h2">{{ section.settings.heading }}</h2>
    {%- if section.settings.subtext != blank -%}
      <p class="bw-body" style="margin-top:10px">{{ section.settings.subtext }}</p>
    {%- endif -%}

    {%- form 'contact', id: 'contact-section-form' -%}
      {%- if form.posted_successfully? -%}
        <p class="bw-body" style="margin-top:20px">{{ section.settings.success_text }}</p>
      {%- else -%}
        {{ form.errors | default_errors }}
        <div style="display:flex;flex-direction:column;gap:10px;margin-top:20px">
          <label class="bw-visually-hidden" for="ContactName-{{ section.id }}">{{ 'contact.form.name' | t }}</label>
          <input id="ContactName-{{ section.id }}" type="text" name="contact[name]" class="bw-field" placeholder="{{ 'contact.form.name' | t }}" value="{{ form.name }}" autocomplete="name">
          <label class="bw-visually-hidden" for="ContactEmail-{{ section.id }}">{{ 'contact.form.email' | t }}</label>
          <input id="ContactEmail-{{ section.id }}" type="email" name="contact[email]" class="bw-field" placeholder="{{ 'contact.form.email' | t }}" value="{{ form.email }}" autocomplete="email" required>
          <label class="bw-visually-hidden" for="ContactPhone-{{ section.id }}">{{ 'contact.form.phone' | t }}</label>
          <input id="ContactPhone-{{ section.id }}" type="tel" name="contact[phone]" class="bw-field" placeholder="{{ 'contact.form.phone' | t }}" value="{{ form.phone }}" autocomplete="tel">
          <label class="bw-visually-hidden" for="ContactBody-{{ section.id }}">{{ 'contact.form.message' | t }}</label>
          <textarea id="ContactBody-{{ section.id }}" name="contact[body]" class="bw-field" rows="5" placeholder="{{ 'contact.form.message' | t }}" required>{{ form.body }}</textarea>
          <button type="submit" class="bw-btn bw-btn--block">{{ section.settings.submit_label }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in touch" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Questions about sizing, orders, or anything else — we usually reply within a day." },
    { "type": "text", "id": "submit_label", "label": "Submit button label", "default": "Send message" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thanks — we'll get back to you shortly." },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
