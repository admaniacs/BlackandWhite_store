<div class="bw-collection-hero color-{{ section.settings.hero_color_scheme }}" style="background:var(--paper);color:var(--ink);position:relative;overflow:hidden;padding-top:{{ section.settings.hero_padding_top }}px;padding-bottom:{{ section.settings.hero_padding_bottom }}px">
  <div>
    <div class="bw-label-mono" style="opacity:.6">Home / {{ 'collections.list.title' | t }}</div>
    <h1 class="bw-display" style="font-size:calc(var(--heading-scale) * clamp(32px,5vw,56px));margin-top:8px">{{ 'collections.list.title' | t }}</h1>
  </div>
  {% content_for 'blocks' %}
</div>

<div class="bw-container" style="padding-top:34px;padding-bottom:34px">
  <div class="bw-grid bw-grid--3 bw-grid--flush">
    {%- for coll in collections -%}
      {%- if section.settings.hide_empty and coll.products_count == 0 -%}{%- continue -%}{%- endif -%}
      <a href="{{ coll.url }}" class="bw-product-card">
        <div class="bw-media-placeholder bw-product-card__media">
          {%- if coll.image -%}
            <img src="{{ coll.image | image_url: width: 900 }}" alt="{{ coll.image.alt | escape }}" loading="lazy">
          {%- else -%}{{ coll.title }} · 900×720{%- endif -%}
        </div>
        <div class="bw-product-card__body">
          <span class="bw-product-card__title">{{ coll.title }}</span>
          <span class="bw-label-mono">{{ 'collections.list.products_count' | t: count: coll.products_count }}</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "List of collections",
  "settings": [
    { "type": "checkbox", "id": "hide_empty", "label": "Hide collections with no products", "default": true },
    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "hero_color_scheme", "label": "Hero color scheme", "default": "scheme-2" },
    { "type": "header", "content": "Hero layout" },
    { "type": "range", "id": "hero_padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "hero_padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 28 }
  ],
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ]
}
{% endschema %}
