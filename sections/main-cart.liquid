<div class="bw-container" style="--ink:{{ section.settings.text_color }};--paper:{{ section.settings.background_color }};background:var(--paper);color:var(--ink);position:relative;overflow:hidden;padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  {%- render 'section-media-background', image: section.settings.background_image, video: section.settings.background_video, overlay_opacity: section.settings.background_overlay_opacity -%}
  <div class="bw-section-content">
  <div class="bw-h2">{{ 'general.cart.title' | t }} ({{ cart.item_count }})</div>

  {%- if cart.item_count == 0 -%}
    <p class="bw-body" style="margin-top:20px">{{ 'general.cart.empty' | t }}</p>
    <a href="{{ routes.all_products_collection_url }}" class="bw-btn" style="margin-top:16px">Continue shopping</a>
  {%- else -%}
    {%- form 'cart', cart -%}
      <div style="display:flex;flex-direction:column;gap:1px;background:var(--grey-20);margin-top:20px">
        {%- for item in cart.items -%}
          <div class="bw-cart-line" style="background:var(--paper);padding:16px" data-cart-line data-line-key="{{ item.key }}">
            <div class="bw-cart-line__media bw-media-placeholder">
              {%- if item.image -%}<img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.image.alt | escape }}" loading="lazy">{%- endif -%}
            </div>
            <div style="flex:1">
              <div style="display:flex;justify-content:space-between">
                <a href="{{ item.url }}" style="font:600 13px var(--font-ui);text-transform:uppercase">{{ item.product.title }}</a>
                <span style="font:700 13px var(--font-ui)">{{ item.final_line_price | money }}</span>
              </div>
              <div class="bw-label-mono" style="margin-top:4px">{{ item.variant.title }}</div>
              <div style="display:flex;align-items:center;justify-content:space-between;margin-top:12px">
                <div class="bw-qty-stepper" data-qty-stepper>
                  <button type="button" data-qty-decrease aria-label="Decrease quantity">−</button>
                  <span data-qty-value>{{ item.quantity }}</span>
                  <button type="button" data-qty-increase aria-label="Increase quantity">+</button>
                </div>
                <button type="button" class="bw-label-mono" style="text-decoration:underline" data-cart-remove>{{ 'general.cart.remove' | t }}</button>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <div style="display:flex;justify-content:flex-end;margin-top:24px">
        <div style="width:320px">
          <div class="bw-summary-row"><span>{{ 'general.cart.subtotal' | t }}</span><span>{{ cart.total_price | money }}</span></div>
          <div class="bw-summary-total"><span class="bw-h3" style="font-size:18px">{{ 'general.cart.total' | t }}</span><span style="font:700 20px var(--font-ui)">{{ cart.total_price | money }}</span></div>
          <button type="submit" name="checkout" class="bw-btn bw-btn--block" style="margin-top:14px">{{ 'general.cart.checkout' | t }}</button>
        </div>
      </div>
    {%- endform -%}
  {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cart",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#000000" },
    { "type": "header", "content": "Background image or video" },
    { "type": "image_picker", "id": "background_image", "label": "Background image", "info": "Used when no background video is set." },
    { "type": "video", "id": "background_video", "label": "Background video", "info": "Takes priority over the background image." },
    { "type": "range", "id": "background_overlay_opacity", "label": "Darkening overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 0 }
  ]
}
{% endschema %}
