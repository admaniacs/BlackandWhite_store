<div class="color-{{ section.settings.color_scheme }}" style="background:var(--paper);color:var(--ink);position:relative;overflow:hidden;padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  {%- render 'section-media-background', image: section.settings.background_image, video: section.settings.background_video, overlay_opacity: section.settings.background_overlay_opacity -%}
  <div class="bw-container" style="position:relative">
    {%- if section.settings.eyebrow != blank -%}
      <div class="bw-label-mono" style="opacity:.6">{{ section.settings.eyebrow }}</div>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="bw-display" style="font-size:calc(var(--heading-scale) * clamp(30px,5vw,58px));margin-top:8px">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <p style="font:15px/1.6 var(--font-ui);opacity:.72;max-width:520px;margin:14px 0 0">{{ section.settings.body }}</p>
    {%- endif -%}

    <div class="bw-system" data-system>
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="bw-system__slot"
          data-system-slot
          data-name-a="{{ block.settings.name_a | escape }}"
          data-name-b="{{ block.settings.name_b | escape }}"
          data-link-a="{{ block.settings.link_a }}"
          data-link-b="{{ block.settings.link_b }}"
          aria-label="{{ block.settings.label | escape }} — tap to switch colour"
          style="--bw-scale-a:{{ block.settings.scale_a | default: 100 | divided_by: 100.0 }};--bw-scale-b:{{ block.settings.scale_b | default: 100 | divided_by: 100.0 }}"
          {{ block.shopify_attributes }}
        >
          <span class="bw-system__frame">
            {%- if block.settings.image_a -%}
              <img class="bw-system__img bw-system__img--a" src="{{ block.settings.image_a | image_url: width: 500 }}" alt="{{ block.settings.name_a | escape }}" loading="lazy" width="{{ block.settings.image_a.width }}" height="{{ block.settings.image_a.height }}">
            {%- endif -%}
            {%- if block.settings.image_b -%}
              <img class="bw-system__img bw-system__img--b" src="{{ block.settings.image_b | image_url: width: 500 }}" alt="{{ block.settings.name_b | escape }}" loading="lazy" width="{{ block.settings.image_b.width }}" height="{{ block.settings.image_b.height }}">
            {%- endif -%}
            <span class="bw-system__toggle" aria-hidden="true"></span>
          </span>
          <span class="bw-system__label">{{ block.settings.label }}</span>
          <span class="bw-system__name" data-system-name>{{ block.settings.name_a }}</span>
        </button>
      {%- endfor -%}
    </div>

    <div class="bw-system__foot">
      <div class="bw-system__readout">
        <span class="bw-label-mono" style="opacity:.6">{{ section.settings.readout_label }}</span>
        <span class="bw-system__outfit" data-system-outfit aria-live="polite"></span>
      </div>
      <div class="bw-system__count">
        <span class="bw-system__count-num" data-system-count>{{ section.blocks.size | default: 0 }}</span>
        <span class="bw-label-mono" style="opacity:.6">{{ section.settings.count_label }}</span>
      </div>
    </div>

    {%- if section.settings.cta_text != blank -%}
      <a href="{{ section.settings.cta_link }}" class="bw-btn" style="margin-top:22px;display:inline-flex">{{ section.settings.cta_text }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Home — the system",
  "blocks": [
    {
      "type": "piece",
      "name": "Piece",
      "settings": [
        { "type": "text", "id": "label", "label": "Slot label", "default": "Top" },
        { "type": "header", "content": "White" },
        { "type": "image_picker", "id": "image_a", "label": "Image" },
        { "type": "text", "id": "name_a", "label": "Name", "default": "White tee" },
        { "type": "range", "id": "scale_a", "label": "Image scale", "info": "Nudge until the garment matches the others. Source photos vary in aspect.", "min": 50, "max": 130, "step": 1, "unit": "%", "default": 100 },
        { "type": "url", "id": "link_a", "label": "Link" },
        { "type": "header", "content": "Black" },
        { "type": "image_picker", "id": "image_b", "label": "Image" },
        { "type": "text", "id": "name_b", "label": "Name", "default": "Black tee" },
        { "type": "range", "id": "scale_b", "label": "Image scale", "info": "Nudge until the garment matches the others.", "min": 50, "max": 130, "step": 1, "unit": "%", "default": 100 },
        { "type": "url", "id": "link_b", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The system" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four pieces. Sixteen outfits." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Every piece is black, white, or both — so nothing clashes and everything pairs. Tap a piece to switch its colour and build the outfit." },
    { "type": "text", "id": "readout_label", "label": "Readout label", "default": "You're wearing" },
    { "type": "text", "id": "count_label", "label": "Count label", "default": "combinations" },
    { "type": "text", "id": "cta_text", "label": "Button label", "default": "Shop the system" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Background image or video" },
    { "type": "image_picker", "id": "background_image", "label": "Background image", "info": "Used when no background video is set." },
    { "type": "video", "id": "background_video", "label": "Background video", "info": "Takes priority over the background image." },
    { "type": "range", "id": "background_overlay_opacity", "label": "Darkening overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 0 }
  ],
  "presets": [
    {
      "name": "Home — the system",
      "blocks": [
        { "type": "piece", "settings": { "label": "Top", "name_a": "White tee", "name_b": "Black tee" } },
        { "type": "piece", "settings": { "label": "Layer", "name_a": "White check shirt", "name_b": "Black check shirt" } },
        { "type": "piece", "settings": { "label": "Outer", "name_a": "White hoodie", "name_b": "Black hoodie" } },
        { "type": "piece", "settings": { "label": "Shoes", "name_a": "White court low", "name_b": "Black court low" } }
      ]
    }
  ]
}
{% endschema %}
