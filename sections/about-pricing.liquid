<div style="display:grid;grid-template-columns:1fr 1.2fr;border-top:1px solid var(--ink);background:var(--paper);color:var(--ink);margin-top:{{ section.settings.padding_top }}px;margin-bottom:{{ section.settings.padding_bottom }}px" class="bw-split-media color-{{ section.settings.color_scheme }}">
  <div class="bw-media-placeholder" style="height:400px;order:{% if section.settings.image_position == 'right' %}2{% else %}1{% endif %};{% if section.settings.image_position == 'right' %}border-left:1px solid var(--ink){% endif %}">
    {%- if section.settings.image -%}
      <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="" loading="lazy">
    {%- else -%}studio / mill photo · 1000×800{%- endif -%}
  </div>
  <div style="padding:30px 28px;order:{% if section.settings.image_position == 'right' %}1{% else %}2{% endif %};{% unless section.settings.image_position == 'right' %}border-left:1px solid var(--ink){% endunless %}">
    <div class="bw-h2" style="font-size:28px">{{ section.settings.heading }}</div>
    <p class="bw-body" style="margin:10px 0 18px;color:#444">{{ section.settings.body }}</p>
    <div style="display:flex;flex-direction:column;gap:1px;background:#e3e3e3;border:1px solid #e3e3e3">
      {%- for block in section.blocks -%}
        <div style="background:var(--paper);display:flex;justify-content:space-between;padding:12px;font:600 12px var(--font-ui);text-transform:uppercase">
          {{ block.settings.label }}<span style="font:500 12px var(--font-mono)">{{ block.settings.amount }}</span>
        </div>
      {%- endfor -%}
      <div style="background:{{ section.settings.total_row_background_color }};color:{{ section.settings.total_row_text_color }};display:flex;justify-content:space-between;padding:12px;font:600 12px var(--font-ui);text-transform:uppercase">
        {{ section.settings.total_label }}<span style="font:500 12px var(--font-mono)">{{ section.settings.total_amount }}</span>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About pricing breakdown",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How we price it" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "We make one fabric in bulk and cut everything from it. No seasonal dyes, no colour minimums, no dead stock to discount. That's why a 420gsm hoodie is $58 and stays $58." },
    { "type": "text", "id": "total_label", "label": "Total row label", "default": "You pay" },
    { "type": "text", "id": "total_amount", "label": "Total row amount", "default": "$58" },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "range", "id": "padding_top", "label": "Space above", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Space below", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "color", "id": "total_row_background_color", "label": "Total row background", "default": "#000000" },
    { "type": "color", "id": "total_row_text_color", "label": "Total row text", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "line",
      "name": "Cost line",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "amount", "label": "Amount" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "About pricing breakdown",
      "blocks": [
        { "type": "line", "settings": { "label": "Fabric & make", "amount": "$21" } },
        { "type": "line", "settings": { "label": "Shipping & duty", "amount": "$6" } },
        { "type": "line", "settings": { "label": "Team & overhead", "amount": "$19" } }
      ]
    }
  ]
}
{% endschema %}
