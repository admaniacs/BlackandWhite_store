<div class="color-{{ section.settings.color_scheme }}" style="background:var(--paper);color:var(--ink);position:relative;overflow:hidden;padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  {%- render 'section-media-background', image: section.settings.background_image, video: section.settings.background_video, overlay_opacity: section.settings.background_overlay_opacity -%}
  <div class="bw-container" style="position:relative">
    {%- if section.settings.eyebrow != blank -%}
      <div class="bw-label-mono">{{ section.settings.eyebrow }}</div>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <div class="bw-display" style="font-size:calc(var(--heading-scale) * clamp(30px,5vw,54px));margin-top:8px;margin-bottom:34px">{{ section.settings.heading }}</div>
    {%- endif -%}

    <div class="bw-timeline">
      {%- for block in section.blocks -%}
        <div class="bw-timeline__item{% if block.settings.is_current %} is-current{% endif %}" {{ block.shopify_attributes }}>
          <div class="bw-timeline__year">{{ block.settings.year }}</div>
          <div class="bw-timeline__title">{{ block.settings.title }}</div>
          <p class="bw-timeline__body">{{ block.settings.body }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About timeline",
  "blocks": [
    {
      "type": "moment",
      "name": "Moment",
      "settings": [
        { "type": "text", "id": "year", "label": "Year", "default": "2024" },
        { "type": "text", "id": "title", "label": "Title", "default": "A milestone" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "What happened, in a sentence or two." },
        { "type": "checkbox", "id": "is_current", "label": "Mark as the current chapter", "default": false }
      ]
    }
  ],
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it went" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From one hoodie to a whole wardrobe." },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Background image or video" },
    { "type": "image_picker", "id": "background_image", "label": "Background image", "info": "Used when no background video is set." },
    { "type": "video", "id": "background_video", "label": "Background video", "info": "Takes priority over the background image." },
    { "type": "range", "id": "background_overlay_opacity", "label": "Darkening overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 0 }
  ],
  "presets": [
    {
      "name": "About timeline",
      "blocks": [
        { "type": "moment", "settings": { "year": "2023", "title": "One hoodie", "body": "We made a single heavyweight hoodie because we couldn't find one that survived a year. It sold out to friends before it reached a shop." } },
        { "type": "moment", "settings": { "year": "2024", "title": "The rule arrives", "body": "Adding colours meant dye minimums, dead stock and discounts. We dropped the colour chart instead, and the range got better." } },
        { "type": "moment", "settings": { "year": "2025", "title": "Shirts and tees", "body": "Same fabric philosophy, different cuts. The check shirt became the one exception we allow ourselves." } },
        { "type": "moment", "settings": { "year": "2026", "title": "A full wardrobe", "body": "Footwear, hats and watches close the loop. Eight pieces now cover a week without repeating an outfit.", "is_current": true } }
      ]
    }
  ]
}
{% endschema %}
