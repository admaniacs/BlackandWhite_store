<div class="color-{{ section.settings.color_scheme }}" style="background:var(--paper);color:var(--ink);padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;text-align:center">
  <div class="bw-container" style="max-width:520px">
    <div class="bw-h2">{{ section.settings.heading }}</div>
    {%- if section.settings.subtext != blank -%}
      <p class="bw-body" style="margin-top:10px">{{ section.settings.subtext }}</p>
    {%- endif -%}
    {%- form 'customer', id: 'newsletter-section-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="bw-body" style="margin-top:18px">{{ section.settings.success_text }}</p>
      {%- else -%}
        <div style="display:flex;gap:8px;margin-top:20px;max-width:400px;margin-left:auto;margin-right:auto">
          <input type="email" name="contact[email]" class="bw-field" placeholder="email address" required aria-label="Email address">
          <button type="submit" class="bw-btn">Join</button>
        </div>
        {%- if form.errors -%}
          <p class="bw-body" style="margin-top:10px;color:#c00">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the list" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Drop alerts, restocks, and nothing else." },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "You're on the list." },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
