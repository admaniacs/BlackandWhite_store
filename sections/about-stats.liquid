<div class="bw-stat-grid" style="--ink:{{ section.settings.divider_color }};--paper:{{ section.settings.background_color }};color:{{ section.settings.text_color }};margin-top:{{ section.settings.padding_top }}px;margin-bottom:{{ section.settings.padding_bottom }}px;text-align:{{ section.settings.text_alignment }}">
  {%- for block in section.blocks -%}
    <div class="bw-stat-grid__item">
      <div class="bw-stat-grid__number">{{ block.settings.number }}</div>
      <div class="bw-label-mono" style="margin-top:4px">{{ block.settings.label }}</div>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "About stats",
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "0" },
        { "type": "text", "id": "label", "label": "Label" }
      ]
    }
  ],
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "left" },
    { "type": "range", "id": "padding_top", "label": "Space above", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Space below", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Cell background color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#000000" },
    { "type": "color", "id": "divider_color", "label": "Divider color", "default": "#000000" }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "About stats",
      "blocks": [
        { "type": "stat", "settings": { "number": "119", "label": "Products, total" } },
        { "type": "stat", "settings": { "number": "2", "label": "Colours, forever" } },
        { "type": "stat", "settings": { "number": "0", "label": "Fake discounts" } }
      ]
    }
  ]
}
{% endschema %}
