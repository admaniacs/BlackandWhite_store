<div class="color-{{ section.settings.color_scheme }}" style="background:var(--paper);color:var(--ink);padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="bw-container">
    {%- if section.settings.heading != blank -%}
      <div class="bw-h2" style="text-align:{{ section.settings.text_alignment }};margin-bottom:30px">{{ section.settings.heading }}</div>
    {%- endif -%}
    <div class="bw-multicolumn" style="--bw-multicolumn-cols:{{ section.settings.columns_desktop }};text-align:{{ section.settings.text_alignment }}">
      {%- for block in section.blocks -%}
        <div class="bw-multicolumn__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image -%}
            <div class="bw-multicolumn__icon">
              <img src="{{ block.settings.image | image_url: width: 120 }}" alt="" loading="lazy" width="48" height="48">
            </div>
          {%- elsif block.settings.emoji != blank -%}
            <div class="bw-multicolumn__icon bw-multicolumn__icon--emoji" aria-hidden="true">{{ block.settings.emoji }}</div>
          {%- endif -%}
          <div class="bw-h3" style="font-size:18px;margin-top:14px">{{ block.settings.title }}</div>
          {%- if block.settings.text != blank -%}
            <p class="bw-body" style="margin-top:8px">{{ block.settings.text }}</p>
          {%- endif -%}
          {%- if block.settings.link_text != blank -%}
            <a href="{{ block.settings.link }}" class="bw-nav-link" style="text-decoration:underline;display:inline-block;margin-top:12px">{{ block.settings.link_text }} →</a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Multicolumn",
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Icon image", "info": "Overrides the emoji below when set." },
        { "type": "text", "id": "emoji", "label": "Emoji icon", "default": "✦" },
        { "type": "text", "id": "title", "label": "Title", "default": "Heavyweight cotton" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>420gsm, brushed inside. Doesn't go see-through, doesn't pill.</p>" },
        { "type": "text", "id": "link_text", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why it's built this way" },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "center" },
    { "type": "range", "id": "columns_desktop", "label": "Columns (desktop)", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 60 },
    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Multicolumn",
      "blocks": [
        { "type": "column", "settings": { "emoji": "🧵", "title": "Heavyweight cotton", "text": "<p>420gsm, brushed inside. Doesn't go see-through, doesn't pill.</p>" } },
        { "type": "column", "settings": { "emoji": "⚫", "title": "Two colours only", "text": "<p>No seasonal palette to chase. Everything works with everything.</p>" } },
        { "type": "column", "settings": { "emoji": "📦", "title": "Ships in 1–2 days", "text": "<p>Free over $75, flat $5 under that.</p>" } }
      ]
    }
  ]
}
{% endschema %}
