{%- assign header_style = 'background:var(--paper);color:var(--ink);position:relative;padding-top:' | append: section.settings.padding_top | append: 'px;padding-bottom:' | append: section.settings.padding_bottom | append: 'px;--logo-h:' | append: settings.logo_height | append: 'px;--logo-h-mobile:' | append: settings.logo_height_mobile | append: 'px' -%}
<header class="bw-header color-{{ section.settings.color_scheme }}" data-header style="{{ header_style }}">
  {%- render 'section-media-background', image: section.settings.background_image, video: section.settings.background_video, overlay_opacity: section.settings.background_overlay_opacity -%}
  <button type="button" class="bw-burger bw-hide-desktop" data-mobile-nav-toggle aria-label="Menu" aria-expanded="false">☰</button>

  <a href="{{ routes.root_url }}" class="bw-header__logo">
    {%- if settings.logo != blank -%}
      <img
        src="{{ settings.logo | image_url: width: 400 }}"
        alt="{{ shop.name }}"
        class="bw-header__logo-img"
        width="{{ settings.logo.width }}"
        height="{{ settings.logo.height }}"
        loading="eager"
      >
    {%- else -%}
      {{ shop.name | default: 'B/W' }}
    {%- endif -%}
  </a>

  <nav class="bw-header__nav bw-hide-mobile" aria-label="Main">
    {%- for link in linklists[section.settings.menu].links -%}
      {%- if link.links != blank -%}
        <div class="bw-nav-dropdown">
          <button type="button" class="bw-nav-link bw-nav-dropdown__trigger{% if link.active %} is-active{% endif %}" aria-expanded="false">
            {{ link.title }}
            <svg width="9" height="6" viewBox="0 0 9 6" fill="none" aria-hidden="true"><path d="M1 1l3.5 3.5L8 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="bw-nav-dropdown__panel">
            {%- for child_link in link.links -%}
              <a href="{{ child_link.url }}" class="bw-nav-dropdown__link{% if child_link.active %} is-active{% endif %}">{{ child_link.title }}</a>
            {%- endfor -%}
          </div>
        </div>
      {%- else -%}
        <a href="{{ link.url }}" class="bw-nav-link{% if link.active %} is-active{% endif %}">{{ link.title }}</a>
      {%- endif -%}
    {%- endfor -%}
  </nav>

  <div class="bw-header__actions">
    <button type="button" class="bw-hide-mobile" data-search-open>Search</button>
    <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="bw-hide-mobile">Account</a>
    <button type="button" data-cart-open>
      <span class="bw-cart-count">Cart ({{ cart.item_count }})</span>
    </button>
  </div>
</header>

<nav class="bw-mobile-nav color-{{ section.settings.color_scheme }}" data-mobile-nav hidden style="{{ header_style }}">
  <div class="bw-container" style="padding-top:16px;padding-bottom:16px;border-bottom:1px solid var(--ink)">
    {%- for link in linklists[section.settings.menu].links -%}
      {%- if link.links != blank -%}
        <div class="bw-mobile-nav__group">
          <button type="button" class="bw-nav-link bw-mobile-nav__trigger" style="display:flex;align-items:center;justify-content:space-between;width:100%;padding:10px 0" aria-expanded="false">
            {{ link.title }}
            <svg width="9" height="6" viewBox="0 0 9 6" fill="none" aria-hidden="true"><path d="M1 1l3.5 3.5L8 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="bw-mobile-nav__submenu">
            <div class="bw-mobile-nav__submenu-inner">
              {%- for child_link in link.links -%}
                <a href="{{ child_link.url }}" class="bw-nav-link" style="display:block;padding:8px 0 8px 16px;font-size:12px">{{ child_link.title }}</a>
              {%- endfor -%}
            </div>
          </div>
        </div>
      {%- else -%}
        <a href="{{ link.url }}" class="bw-nav-link" style="display:block;padding:10px 0">{{ link.title }}</a>
      {%- endif -%}
    {%- endfor -%}
    <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="bw-nav-link" style="display:block;padding:10px 0">Account</a>
  </div>
</nav>

{% schema %}
{
  "name": "Header",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu",
      "default": "main-menu"
    },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 16 },
    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Background image or video" },
    { "type": "image_picker", "id": "background_image", "label": "Background image", "info": "Used when no background video is set." },
    { "type": "video", "id": "background_video", "label": "Background video", "info": "Takes priority over the background image." },
    { "type": "range", "id": "background_overlay_opacity", "label": "Darkening overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 0 }
  ]
}
{% endschema %}
