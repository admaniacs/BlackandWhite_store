<div class="color-{{ section.settings.color_scheme }}" style="background:var(--paper);color:var(--ink);padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;text-align:center" data-countdown data-countdown-target="{{ section.settings.target_date }}">
  <div class="bw-container">
    {%- if section.settings.heading != blank -%}
      <div class="bw-label-mono">{{ section.settings.heading }}</div>
    {%- endif -%}
    <div class="bw-countdown" data-countdown-display style="margin-top:14px">
      <div class="bw-countdown__unit"><span class="bw-countdown__number" data-countdown-days>00</span><span class="bw-label-mono">Days</span></div>
      <div class="bw-countdown__unit"><span class="bw-countdown__number" data-countdown-hours>00</span><span class="bw-label-mono">Hrs</span></div>
      <div class="bw-countdown__unit"><span class="bw-countdown__number" data-countdown-minutes>00</span><span class="bw-label-mono">Min</span></div>
      <div class="bw-countdown__unit"><span class="bw-countdown__number" data-countdown-seconds>00</span><span class="bw-label-mono">Sec</span></div>
    </div>
    <div class="bw-body" data-countdown-expired hidden style="margin-top:14px">{{ section.settings.expired_text }}</div>
    {%- if section.settings.cta_text != blank -%}
      <a href="{{ section.settings.cta_link }}" class="bw-btn" style="margin-top:22px">{{ section.settings.cta_text }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Countdown",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Drop 05 lands in" },
    { "type": "text", "id": "target_date", "label": "Target date & time", "default": "2026-12-31T09:00:00", "info": "Format: YYYY-MM-DDTHH:MM:SS, in the store's local time." },
    { "type": "text", "id": "expired_text", "label": "Expired message", "default": "It's live." },
    { "type": "text", "id": "cta_text", "label": "Button label" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" }
  ],
  "presets": [{ "name": "Countdown" }]
}
{% endschema %}
