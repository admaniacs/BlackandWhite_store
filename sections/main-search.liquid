<div class="bw-collection-hero color-{{ section.settings.hero_color_scheme }}" style="background:var(--paper);color:var(--ink);position:relative;overflow:hidden;padding-top:{{ section.settings.hero_padding_top }}px;padding-bottom:{{ section.settings.hero_padding_bottom }}px">
  {%- render 'section-media-background', image: section.settings.hero_background_image, video: section.settings.hero_background_video, overlay_opacity: section.settings.hero_background_overlay_opacity -%}
  <div>
    <div class="bw-label-mono" style="opacity:.6">Home / Search</div>
    <h1 class="bw-display" style="font-size:calc(var(--heading-scale) * clamp(32px,5vw,56px));margin-top:8px">{% if search.terms != blank %}"{{ search.terms }}"{% else %}Search{% endif %}</h1>
  </div>
  <p style="font:14px/1.5 var(--font-ui);opacity:.7;max-width:340px;margin:0">
    {%- if search.performed -%}
      {{ 'general.search.results_count' | t: count: search.results_count }}
    {%- endif -%}
  </p>
  {% content_for 'blocks' %}
</div>

<form action="{{ routes.search_url }}" method="get" role="search" class="bw-container" style="padding-top:20px;padding-bottom:20px;display:flex;gap:8px">
  <input type="search" name="q" value="{{ search.terms | escape }}" class="bw-field" placeholder="{{ 'general.search.placeholder' | t }}">
  <input type="hidden" name="type" value="product">
  <button type="submit" class="bw-btn">{{ 'general.search.placeholder' | t }}</button>
</form>

<div class="bw-container" style="padding-bottom:34px">
  {%- paginate search.results by 24 -%}
    {%- if search.performed and search.results.size > 0 -%}
      <div class="bw-grid bw-grid--3 bw-grid--flush">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {%- render 'product-card', product: item, show_sizes: false, quick_add: true -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if paginate.next -%}
        <div class="bw-load-more">
          <a href="{{ paginate.next.url }}" class="bw-btn bw-btn--outline">{{ 'collections.general.load_more' | t }}</a>
        </div>
      {%- endif -%}
    {%- else -%}
      {%- comment -%}
        Nothing to list — either no search has run yet, or it found nothing.
        Either way the page shouldn't dead-end, so offer a way back in.
      {%- endcomment -%}
      {%- if search.performed -%}
        <p class="bw-body">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      {%- endif -%}

      {%- assign suggested_terms = section.settings.popular_terms | split: ',' -%}
      {%- if suggested_terms.size > 0 -%}
        <div class="bw-search-suggest">
          <div class="bw-label-mono">{{ section.settings.popular_heading }}</div>
          <div class="bw-search-chips">
            {%- for term in suggested_terms -%}
              {%- assign clean_term = term | strip -%}
              {%- if clean_term != blank -%}
                <a href="{{ routes.search_url }}?q={{ clean_term | url_encode }}&type=product" class="bw-search-chip">{{ clean_term }}</a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.preview_collection != blank -%}
        {%- assign preview_source = collections[section.settings.preview_collection] -%}
      {%- else -%}
        {%- assign preview_source = collections.all -%}
      {%- endif -%}

      {%- if preview_source.products.size > 0 -%}
        <div class="bw-search-preview">
          <div class="bw-search-preview__head">
            <div class="bw-h3">{{ section.settings.preview_heading }}</div>
            <a href="{{ preview_source.url | default: routes.all_products_collection_url }}" class="bw-nav-link" style="text-decoration:underline">{{ section.settings.preview_link_label }} →</a>
          </div>
          <div class="bw-grid bw-grid--3 bw-grid--flush">
            {%- for product in preview_source.products limit: section.settings.preview_count -%}
              {%- render 'product-card', product: product, show_sizes: false, quick_add: true -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Search results",
  "settings": [
    { "type": "header", "content": "Empty state", "info": "Shown before a search is run, and when a search finds nothing." },
    { "type": "text", "id": "popular_heading", "label": "Popular searches heading", "default": "Try one of these" },
    { "type": "text", "id": "popular_terms", "label": "Popular search terms", "info": "Separate with commas.", "default": "Hoodies, Tees, Shirts, Sneakers, Watch, White, Black" },
    { "type": "text", "id": "preview_heading", "label": "Product preview heading", "default": "Or start here" },
    { "type": "collection", "id": "preview_collection", "label": "Products to preview", "info": "Leave empty to show all products." },
    { "type": "range", "id": "preview_count", "label": "Products to show", "min": 3, "max": 12, "step": 3, "default": 6 },
    { "type": "text", "id": "preview_link_label", "label": "Preview link label", "default": "Browse everything" },
    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "hero_color_scheme", "label": "Hero color scheme", "default": "scheme-2" },
    { "type": "header", "content": "Hero background image or video" },
    { "type": "image_picker", "id": "hero_background_image", "label": "Background image", "info": "Used when no background video is set." },
    { "type": "video", "id": "hero_background_video", "label": "Background video", "info": "Takes priority over the background image." },
    { "type": "range", "id": "hero_background_overlay_opacity", "label": "Darkening overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 0 },
    { "type": "header", "content": "Hero layout" },
    { "type": "range", "id": "hero_padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "hero_padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 28 }
  ],
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ]
}
{% endschema %}
