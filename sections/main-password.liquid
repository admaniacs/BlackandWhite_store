<div class="bw-password-screen color-{{ section.settings.color_scheme }}" style="background:var(--paper);color:var(--ink)">
  <div class="bw-header__logo" style="font-size:30px">
    {%- if settings.logo != blank -%}
      <img src="{{ settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}" style="height:40px;width:auto;display:block;margin:0 auto" loading="eager">
    {%- else -%}
      {{ shop.name | default: 'B/W' }}
    {%- endif -%}
  </div>

  <h1 class="bw-display" style="font-size:calc(var(--heading-scale) * clamp(32px,6vw,60px))">{{ section.settings.heading }}</h1>

  {%- unless shop.password_message == blank -%}
    <div class="bw-body" style="max-width:460px">{{ shop.password_message }}</div>
  {%- else -%}
    <p class="bw-body" style="max-width:460px">{{ section.settings.subtext }}</p>
  {%- endunless -%}

  {%- form 'storefront_password', class: 'bw-password-screen__form' -%}
    {{ form.errors | default_errors }}
    <input type="password" name="password" class="bw-field" placeholder="{{ 'password.login_form_heading' | t }}" required>
    <button type="submit" class="bw-btn">Enter</button>
  {%- endform -%}

  {%- if section.settings.show_signup -%}
    {%- form 'customer', id: 'password-signup', class: 'bw-password-screen__signup' -%}
      <input type="hidden" name="contact[tags]" value="prospect, password page">
      <div class="bw-footer__signup">
        <input type="email" name="contact[email]" placeholder="{{ 'password.signup_form_email_label' | t }}" required aria-label="Email address">
        <button type="submit">{{ 'password.signup_form_button_label' | t }}</button>
      </div>
    {%- endform -%}
  {%- endif -%}

  <div style="display:flex;gap:16px">
    {%- if section.settings.social_instagram != blank -%}<a href="{{ section.settings.social_instagram }}" class="bw-nav-link" style="text-decoration:underline">Instagram</a>{%- endif -%}
    {%- if section.settings.social_tiktok != blank -%}<a href="{{ section.settings.social_tiktok }}" class="bw-nav-link" style="text-decoration:underline">TikTok</a>{%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something's coming." },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "info": "Shown when no store password message is set in Online Store → Preferences.", "default": "Two colours, heavy fabric, honest prices. Leave your email and we'll let you know when we open." },
    { "type": "checkbox", "id": "show_signup", "label": "Show email signup", "default": true },
    { "type": "header", "content": "Social links" },
    { "type": "url", "id": "social_instagram", "label": "Instagram" },
    { "type": "url", "id": "social_tiktok", "label": "TikTok" },
    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" }
  ]
}
{% endschema %}
