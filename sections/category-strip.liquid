<div class="bw-category-strip color-{{ section.settings.color_scheme }}" style="background:var(--paper);color:var(--ink);margin-top:{{ section.settings.padding_top }}px;margin-bottom:{{ section.settings.padding_bottom }}px">
  {%- for block in section.blocks -%}
    {%- assign coll = collections[block.settings.collection] -%}
    <a href="{{ coll.url | default: '#' }}">
      {{ block.settings.label | default: coll.title }}
      <div class="bw-category-strip__count">{{ coll.products_count | default: 0 }}</div>
    </a>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Category strip",
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label override" }
      ]
    }
  ],
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "label": "Space above", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Space below", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Category strip",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
