<div class="bw-category-strip" style="--ink:{{ section.settings.text_color }};--paper:{{ section.settings.background_color }};background:var(--paper);color:var(--ink)">
  {%- for block in section.blocks -%}
    {%- assign coll = collections[block.settings.collection] -%}
    <a href="{{ coll.url | default: '#' }}">
      {{ block.settings.label | default: coll.title }}
      <div class="bw-category-strip__count">{{ coll.products_count | default: 0 }}</div>
    </a>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Category strip",
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label override" }
      ]
    }
  ],
  "settings": [
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#000000" }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Category strip",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
