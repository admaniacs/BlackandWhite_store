<div
  class="bw-container"
  style="
    position:relative;
    overflow:hidden;
    padding-top:{{ section.settings.padding_top }}px;
    padding-bottom:{{ section.settings.padding_bottom }}px;
    background:{{ section.settings.background_color | default: 'transparent' }};
    color:{{ section.settings.text_color | default: 'inherit' }};
  "
>
  {%- render 'section-media-background', image: section.settings.background_image, video: section.settings.background_video, overlay_opacity: section.settings.background_overlay_opacity -%}
  <div class="bw-section-content">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "Custom content",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    { "type": "paragraph", "content": "A blank section — add Heading, Text, Image, Button, Spacer or Group blocks to build a custom layout anywhere on the site." },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background color" },
    { "type": "color", "id": "text_color", "label": "Text color" },
    { "type": "header", "content": "Background image or video" },
    { "type": "image_picker", "id": "background_image", "label": "Background image", "info": "Used when no background video is set." },
    { "type": "video", "id": "background_video", "label": "Background video", "info": "Takes priority over the background image." },
    { "type": "range", "id": "background_overlay_opacity", "label": "Darkening overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 0 }
  ],
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "presets": [{ "name": "Custom content" }]
}
{% endschema %}
