<div class="bw-media-placeholder" style="position:relative;height:{{ section.settings.hero_height }}px">
  {%- if section.settings.background_video != blank or section.settings.image != blank -%}
    {%- render 'section-media-background', image: section.settings.image, video: section.settings.background_video, overlay_opacity: section.settings.background_overlay_opacity -%}
  {%- else -%}
    watch hero — wrist shot on black · 2400×840
  {%- endif -%}
  <div style="position:absolute;left:24px;bottom:24px;color:{{ section.settings.caption_text_color }}">
    <div class="bw-label-mono" style="color:#999">{{ collection.products_count }} references</div>
    <div class="bw-display" style="font-size:clamp(38px,7vw,76px);margin-top:8px">{{ section.settings.heading }}</div>
    {% content_for 'blocks' %}
  </div>
</div>

<div class="bw-filter-tabs" style="display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:{{ section.settings.accent_color }};border-top:1px solid {{ section.settings.accent_color }}">
  <a href="{{ collection.url }}" style="background:{{ section.settings.tab_background_color }};padding:14px 16px;font:600 11px var(--font-ui);letter-spacing:.1em;text-transform:uppercase">All {{ collection.products_count }}</a>
  {%- for filter in collection.filters -%}
    {%- if filter.type == 'list' -%}
      {%- for value in filter.values limit: 3 -%}
        <a href="{{ value.url_to_add }}" style="background:{{ section.settings.tab_background_color }};padding:14px 16px;font:600 11px var(--font-ui);letter-spacing:.1em;text-transform:uppercase;{% if value.active %}background:{{ section.settings.accent_color }};color:{{ section.settings.accent_text_color }}{% endif %}">{{ value.label }}</a>
      {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Watches hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tell the time. Stop." },
    { "type": "header", "content": "Background image or video" },
    { "type": "image_picker", "id": "image", "label": "Background image", "info": "Used when no background video is set." },
    { "type": "video", "id": "background_video", "label": "Background video", "info": "Takes priority over the background image." },
    { "type": "range", "id": "background_overlay_opacity", "label": "Darkening overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 0 },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "hero_height", "label": "Hero height", "min": 240, "max": 720, "step": 20, "unit": "px", "default": 420 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "caption_text_color", "label": "Caption text color", "default": "#ffffff" },
    { "type": "color", "id": "tab_background_color", "label": "Tab background color", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Active tab / divider color", "default": "#000000" },
    { "type": "color", "id": "accent_text_color", "label": "Active tab text color", "default": "#ffffff" }
  ],
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "presets": [{ "name": "Watches hero" }]
}
{% endschema %}
