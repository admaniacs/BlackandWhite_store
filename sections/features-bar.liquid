<div class="bw-features-bar" style="--ink:{{ section.settings.divider_color }};--paper:{{ section.settings.background_color }};color:{{ section.settings.text_color }};margin-top:{{ section.settings.padding_top }}px;margin-bottom:{{ section.settings.padding_bottom }}px;text-align:{{ section.settings.text_alignment }}">
  {%- for block in section.blocks -%}
    <div class="bw-features-bar__item">
      <div class="bw-features-bar__item-title">{{ block.settings.title }}</div>
      <div class="bw-features-bar__item-body">{{ block.settings.body }}</div>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Features bar",
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "body", "label": "Body" }
      ]
    }
  ],
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "left" },
    { "type": "range", "id": "padding_top", "label": "Space above", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Space below", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Cell background color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#000000" },
    { "type": "color", "id": "divider_color", "label": "Divider color", "default": "#000000" }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Features bar",
      "blocks": [
        { "type": "feature", "settings": { "title": "Free over $75", "body": "$5 flat under that." } },
        { "type": "feature", "settings": { "title": "30-day returns", "body": "Unworn, tags on." } },
        { "type": "feature", "settings": { "title": "True sizing", "body": "Measurements on every page." } },
        { "type": "feature", "settings": { "title": "4.6 / 5", "body": "From 3,410 reviews." } }
      ]
    }
  ]
}
{% endschema %}
