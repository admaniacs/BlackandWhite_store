<div class="bw-split-media" style="border-top:1px solid {{ section.settings.divider_color }};margin-top:{{ section.settings.padding_top }}px;margin-bottom:{{ section.settings.padding_bottom }}px">
  {%- for block in section.blocks -%}
    <a href="{{ block.settings.link }}" class="bw-media-placeholder{% if block.settings.dark %} bw-media-placeholder--dark{% endif %}" style="height:380px;position:relative{% if forloop.index0 == 1 %};border-left:1px solid {{ section.settings.divider_color }}{% endif %}">
      {%- if block.settings.image -%}
        <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
      {%- else -%}
        {{ block.settings.placeholder_label }}
      {%- endif -%}
      <div style="position:absolute;left:24px;bottom:24px;color:{{ block.settings.text_color }}">
        <div class="bw-h2" style="font-size:34px">{{ block.settings.title }}</div>
        <span class="bw-nav-link" style="color:{{ block.settings.text_color }}">{{ block.settings.cta_text }} →</span>
      </div>
    </a>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Split promo",
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "All black" },
        { "type": "text", "id": "cta_text", "label": "Link label", "default": "See the edit" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "placeholder_label", "label": "Placeholder label", "default": "lookbook · 1200×760" },
        { "type": "checkbox", "id": "dark", "label": "Dark placeholder", "default": true },
        { "type": "color", "id": "text_color", "label": "Caption text color", "default": "#ffffff" }
      ]
    }
  ],
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "label": "Space above", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Space below", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "divider_color", "label": "Divider color", "default": "#000000" }
  ],
  "max_blocks": 2,
  "presets": [
    {
      "name": "Split promo",
      "blocks": [
        { "type": "tile", "settings": { "title": "All black", "dark": true, "placeholder_label": "lookbook — black on black · 1200×760", "text_color": "#ffffff" } },
        { "type": "tile", "settings": { "title": "All white", "dark": false, "placeholder_label": "lookbook — white on white · 1200×760", "text_color": "#000000" } }
      ]
    }
  ]
}
{% endschema %}
