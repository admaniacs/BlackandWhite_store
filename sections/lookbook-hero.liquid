<div class="bw-editorial-hero" style="--ink:{{ section.settings.text_color }};--paper:{{ section.settings.background_color }};background:var(--paper);color:var(--ink)">
  <div class="bw-label-mono">{{ section.settings.eyebrow }}</div>
  <div class="bw-display" style="font-size:clamp(40px,8vw,82px);margin-top:10px">{{ section.settings.heading }}</div>
</div>

{% schema %}
{
  "name": "Lookbook hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Drop 04 · shot in Lagos, September" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "No colour, no excuses" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#000000" }
  ],
  "presets": [{ "name": "Lookbook hero" }]
}
{% endschema %}
