<div class="color-{{ section.settings.color_scheme }}" style="background:var(--paper);color:var(--ink);position:relative;overflow:hidden;padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  {%- render 'section-media-background', image: section.settings.background_image, video: section.settings.background_video, overlay_opacity: section.settings.background_overlay_opacity -%}
  <div class="bw-container" style="position:relative">
    {%- if section.settings.eyebrow != blank -%}
      <div class="bw-label-mono">{{ section.settings.eyebrow }}</div>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <div class="bw-display" style="font-size:calc(var(--heading-scale) * clamp(28px,4.4vw,48px));margin-top:8px;margin-bottom:26px">{{ section.settings.heading }}</div>
    {%- endif -%}

    <div class="bw-shoplook" data-shop-the-look>
      <div class="bw-shoplook__figure">
        {%- if section.settings.image -%}
          <img src="{{ section.settings.image | image_url: width: 1400 }}" alt="{{ section.settings.image_alt | escape }}" loading="lazy" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}">
        {%- else -%}
          <div class="bw-media-placeholder bw-media-placeholder--dark" style="position:absolute;inset:0">look · 1400×1750</div>
        {%- endif -%}

        {%- for block in section.blocks -%}
          <button
            type="button"
            class="bw-shoplook__marker"
            style="left:{{ block.settings.position_x }}%;top:{{ block.settings.position_y }}%"
            data-look-marker
            data-look-index="{{ forloop.index0 }}"
            aria-label="{{ block.settings.title | escape }}"
          >{{ forloop.index }}</button>
        {%- endfor -%}
      </div>

      <ol class="bw-shoplook__list">
        {%- for block in section.blocks -%}
          <li>
            <a
              href="{{ block.settings.link }}"
              class="bw-shoplook__piece"
              data-look-piece
              data-look-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              <span class="bw-shoplook__num">{{ forloop.index }}</span>
              <span class="bw-shoplook__meta">
                <span class="bw-shoplook__title">{{ block.settings.title }}</span>
                {%- if block.settings.detail != blank -%}
                  <span class="bw-shoplook__detail">{{ block.settings.detail }}</span>
                {%- endif -%}
              </span>
              {%- if block.settings.price != blank -%}
                <span class="bw-shoplook__price">{{ block.settings.price }}</span>
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Lookbook — shop the look",
  "blocks": [
    {
      "type": "piece",
      "name": "Piece",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Box hoodie" },
        { "type": "text", "id": "detail", "label": "Detail", "info": "Colour, size worn, anything short.", "default": "Black · worn in L" },
        { "type": "text", "id": "price", "label": "Price", "default": "₹699" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "header", "content": "Marker position" },
        { "type": "range", "id": "position_x", "label": "From left", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "position_y", "label": "From top", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 }
      ]
    }
  ],
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Look 01" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything in this frame." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Two people in black and white outfits" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Background image or video" },
    { "type": "image_picker", "id": "background_image", "label": "Background image", "info": "Used when no background video is set." },
    { "type": "video", "id": "background_video", "label": "Background video", "info": "Takes priority over the background image." },
    { "type": "range", "id": "background_overlay_opacity", "label": "Darkening overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 0 }
  ],
  "presets": [
    {
      "name": "Lookbook — shop the look",
      "blocks": [
        { "type": "piece", "settings": { "title": "Box hoodie", "detail": "Black · worn in L", "price": "₹699", "position_x": 38, "position_y": 34 } },
        { "type": "piece", "settings": { "title": "Blank tee", "detail": "White · worn in M", "price": "₹599", "position_x": 64, "position_y": 40 } },
        { "type": "piece", "settings": { "title": "Court low", "detail": "White · 8", "price": "₹2,999", "position_x": 46, "position_y": 82 } }
      ]
    }
  ]
}
{% endschema %}
