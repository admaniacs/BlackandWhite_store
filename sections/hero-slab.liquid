<div class="bw-hero color-{{ section.settings.color_scheme }}" style="position:relative;overflow:hidden;background:var(--paper);color:var(--ink)">
  {%- render 'section-media-background', image: section.settings.background_image, video: section.settings.background_video, overlay_opacity: section.settings.video_overlay_opacity -%}

  <div class="bw-hero__content" style="padding:60px 24px 40px;padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;text-align:{{ section.settings.text_alignment }}">
    <div class="bw-container" style="padding:0">
      <div class="bw-label-mono" style="color:#9a9a9a">{{ section.settings.eyebrow }}</div>
      <div class="bw-display" style="margin-top:14px">{{ section.settings.heading }}</div>
      <div style="display:flex;align-items:flex-end;justify-content:{% if section.settings.text_alignment == 'center' %}center{% else %}space-between{% endif %};gap:40px;margin-top:34px;border-top:1px solid #333;padding-top:20px;flex-wrap:wrap">
        <p style="max-width:420px;font:15px/1.5 var(--font-ui);color:#c9c9c9;margin:0{% if section.settings.text_alignment == 'center' %};margin-left:auto;margin-right:auto{% endif %}">{{ section.settings.subtext }}</p>
        <div style="display:flex;gap:12px;flex-wrap:wrap">
          {%- if section.settings.cta_1_text != blank -%}
            <a href="{{ section.settings.cta_1_link }}" class="bw-btn">{{ section.settings.cta_1_text }}</a>
          {%- endif -%}
          {%- if section.settings.cta_2_text != blank -%}
            <a href="{{ section.settings.cta_2_link }}" class="bw-btn bw-btn--outline">{{ section.settings.cta_2_text }}</a>
          {%- endif -%}
        </div>
      </div>
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero slab",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Autumn drop 04 — live now" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Two colours. Nothing else." },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Heavyweight cotton, honest prices. Every piece is black, white, or both — so everything works with everything." },
    { "type": "text", "id": "cta_1_text", "label": "Primary button label", "default": "Shop all" },
    { "type": "url", "id": "cta_1_link", "label": "Primary button link" },
    { "type": "text", "id": "cta_2_text", "label": "Secondary button label", "default": "Watches" },
    { "type": "url", "id": "cta_2_link", "label": "Secondary button link" },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "left" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 },
    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    {
      "type": "header",
      "content": "Background image or video"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Used when no background video is set."
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "Background video",
      "info": "Muted, looped, autoplays behind the text. Takes priority over the background image. Leave both empty to keep the plain background color."
    },
    {
      "type": "range",
      "id": "video_overlay_opacity",
      "label": "Darkening overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 45,
      "info": "Keeps the headline readable over busy footage."
    }
  ],
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "presets": [{ "name": "Hero slab" }]
}
{% endschema %}
