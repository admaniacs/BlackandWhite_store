<div class="color-{{ section.settings.color_scheme }}" style="background:var(--paper);color:var(--ink);position:relative;overflow:hidden;padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  {%- render 'section-media-background', image: section.settings.background_image, video: section.settings.background_video, overlay_opacity: section.settings.background_overlay_opacity -%}
  <div class="bw-container" style="position:relative">
    {%- if section.settings.eyebrow != blank -%}
      <div class="bw-label-mono">{{ section.settings.eyebrow }}</div>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <div class="bw-display" style="font-size:calc(var(--heading-scale) * clamp(30px,5vw,54px));margin-top:8px">{{ section.settings.heading }}</div>
    {%- endif -%}

    <div class="bw-manifesto">
      {%- for block in section.blocks -%}
        <div class="bw-manifesto__item" {{ block.shopify_attributes }}>
          <div class="bw-manifesto__index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</div>
          <div>
            <div class="bw-manifesto__title">{{ block.settings.title }}</div>
            <p class="bw-manifesto__body">{{ block.settings.body }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About manifesto",
  "blocks": [
    {
      "type": "principle",
      "name": "Principle",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Two colours" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Everything works with everything else." }
      ]
    }
  ],
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What we hold to" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Five rules we don't break." },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Background image or video" },
    { "type": "image_picker", "id": "background_image", "label": "Background image", "info": "Used when no background video is set." },
    { "type": "video", "id": "background_video", "label": "Background video", "info": "Takes priority over the background image." },
    { "type": "range", "id": "background_overlay_opacity", "label": "Darkening overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 0 }
  ],
  "presets": [
    {
      "name": "About manifesto",
      "blocks": [
        { "type": "principle", "settings": { "title": "Two colours", "body": "Black and white, permanently. Anything you buy works with anything you already own." } },
        { "type": "principle", "settings": { "title": "One weight", "body": "We buy a single fabric in bulk and cut the whole range from it. Fewer choices, better cloth." } },
        { "type": "principle", "settings": { "title": "No seasons", "body": "Nothing is discontinued to make room for next season, because there isn't one." } },
        { "type": "principle", "settings": { "title": "One price", "body": "The price on the tag is the price. We don't inflate it in order to discount it later." } },
        { "type": "principle", "settings": { "title": "Made to outlast us", "body": "If a piece doesn't survive a hundred washes looking like itself, we don't sell it." } }
      ]
    }
  ]
}
{% endschema %}
