<div style="display:grid;grid-template-columns:1.4fr 1fr;gap:1px;background:{{ section.settings.divider_color }}">
  {%- assign looks = section.blocks -%}
  {%- if looks.size > 0 -%}
    {%- assign first_look = looks[0] -%}
    <a href="{{ first_look.settings.link }}" class="bw-media-placeholder{% if first_look.settings.dark %} bw-media-placeholder--dark{% endif %}" style="height:520px;position:relative">
      {%- if first_look.settings.image -%}
        <img src="{{ first_look.settings.image | image_url: width: 1400 }}" alt="{{ first_look.settings.caption | escape }}" loading="lazy">
      {%- else -%}{{ first_look.settings.placeholder_label }}{%- endif -%}
      {%- if first_look.settings.caption != blank -%}
        <span class="bw-caption-chip" style="background:{{ first_look.settings.chip_background_color }};color:{{ first_look.settings.chip_text_color }}">{{ first_look.settings.caption }}</span>
      {%- endif -%}
    </a>
    <div style="display:grid;grid-template-rows:1fr 1fr;gap:1px">
      {%- for look in looks offset: 1 limit: 2 -%}
        <a href="{{ look.settings.link }}" class="bw-media-placeholder{% if look.settings.dark %} bw-media-placeholder--dark{% endif %}" style="position:relative">
          {%- if look.settings.image -%}
            <img src="{{ look.settings.image | image_url: width: 1200 }}" alt="{{ look.settings.caption | escape }}" loading="lazy">
          {%- else -%}{{ look.settings.placeholder_label }}{%- endif -%}
          {%- if look.settings.caption != blank -%}
            <span class="bw-caption-chip" style="background:{{ look.settings.chip_background_color }};color:{{ look.settings.chip_text_color }}">{{ look.settings.caption }}</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Lookbook — top split",
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "placeholder_label", "label": "Placeholder label" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "dark", "label": "Dark placeholder", "default": true },
        { "type": "color", "id": "chip_background_color", "label": "Caption chip background", "default": "#ffffff" },
        { "type": "color", "id": "chip_text_color", "label": "Caption chip text", "default": "#000000" }
      ]
    }
  ],
  "settings": [
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "divider_color", "label": "Divider color", "default": "#000000" }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Lookbook — top split",
      "blocks": [
        { "type": "look", "settings": { "placeholder_label": "look 01 — full black fit · 1400×1040", "caption": "Box hoodie $58 · Court low $89", "dark": true, "chip_background_color": "#ffffff", "chip_text_color": "#000000" } },
        { "type": "look", "settings": { "placeholder_label": "look 02 — white on white", "caption": "Blank tee $24", "dark": false, "chip_background_color": "#000000", "chip_text_color": "#ffffff" } },
        { "type": "look", "settings": { "placeholder_label": "look 03 — watch detail", "caption": "Field 36 $145", "dark": true, "chip_background_color": "#ffffff", "chip_text_color": "#000000" } }
      ]
    }
  ]
}
{% endschema %}
