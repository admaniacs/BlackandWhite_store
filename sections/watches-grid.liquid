<div class="bw-grid bw-grid--3 bw-grid--flush" style="border-top:1px solid {{ section.settings.divider_color }}">
  {%- paginate collection.products by: section.settings.products_per_page -%}
    {%- for product in collection.products -%}
      {%- render 'product-card', product: product, show_sizes: false -%}
    {%- endfor -%}
    {%- if paginate.next -%}
      <div class="bw-load-more" style="grid-column:1/-1">
        <a href="{{ paginate.next.url }}" class="bw-btn bw-btn--outline">{{ 'collections.general.load_more' | t }}</a>
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Watches grid",
  "settings": [
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 3, "max": 24, "step": 3, "default": 9 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "divider_color", "label": "Divider color", "default": "#000000" }
  ],
  "presets": [{ "name": "Watches grid" }]
}
{% endschema %}
