<div class="color-{{ section.settings.color_scheme }}" style="background:var(--paper);color:var(--ink);padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="bw-rich-text" style="text-align:{{ section.settings.text_alignment }}">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "center" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 60 },
    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Rich text",
      "blocks": [
        { "type": "heading", "settings": { "text": "Made to outlast the trend cycle", "size": "md" } },
        { "type": "text", "settings": { "text": "<p>One fabric, two colours, no seasonal markdowns. That's the whole business plan.</p>", "alignment": "center" } },
        { "type": "button", "settings": { "text": "Shop the range", "alignment": "center" } }
      ]
    }
  ]
}
{% endschema %}
