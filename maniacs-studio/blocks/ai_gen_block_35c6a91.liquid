{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-process-{{ ai_gen_id }} {
    display: block;
    box-sizing: border-box;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.heading_color }};
  }

  .ai-process-{{ ai_gen_id }} *,
  .ai-process-{{ ai_gen_id }} *::before,
  .ai-process-{{ ai_gen_id }} *::after {
    box-sizing: border-box;
  }

  .ai-process-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: {{ block.settings.column_gap }}px;
    width: 100%;
  }

  .ai-process-{{ ai_gen_id }}__item {
    min-width: 0;
  }

  .ai-process-{{ ai_gen_id }}__rule {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    margin-bottom: 24px;
  }

  .ai-process-{{ ai_gen_id }}__dot {
    display: block;
    flex: 0 0 9px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: {{ block.settings.accent_color }};
  }

  .ai-process-{{ ai_gen_id }}__line {
    display: block;
    height: 1px;
    flex: 1 1 auto;
    background: {{ block.settings.accent_color }};
    opacity: 0.58;
  }

  .ai-process-{{ ai_gen_id }}__label {
    margin: 0 0 13px;
    color: {{ block.settings.accent_color }};
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-size: 11px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ai-process-{{ ai_gen_id }}__heading {
    margin: 0 0 12px;
    color: {{ block.settings.heading_color }};
    font-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .ai-process-{{ ai_gen_id }}__description {
    margin: 0;
    max-width: 28ch;
    color: {{ block.settings.body_color }};
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.65;
  }

  @media screen and (max-width: 749px) {
    .ai-process-{{ ai_gen_id }} {
      width: 100%;
      padding: {{ block.settings.section_padding | divided_by: 2 }}px 20px;
    }

    .ai-process-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 36px;
      column-gap: 24px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-process-{{ ai_gen_id }}__grid {
      grid-template-columns: 1fr;
      row-gap: 30px;
    }

    .ai-process-{{ ai_gen_id }}__rule {
      margin-bottom: 16px;
    }
  }
{% endstyle %}

<div class="ai-process-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-process-{{ ai_gen_id }}__grid">
    {% for i in (1..4) %}
      {% liquid
        assign label_key = 'stage_' | append: i | append: '_label'
        assign heading_key = 'stage_' | append: i | append: '_heading'
        assign description_key = 'stage_' | append: i | append: '_description'
      %}
      <article class="ai-process-{{ ai_gen_id }}__item">
        <div class="ai-process-{{ ai_gen_id }}__rule" aria-hidden="true">
          <span class="ai-process-{{ ai_gen_id }}__dot"></span>
          <span class="ai-process-{{ ai_gen_id }}__line"></span>
        </div>
        {% if block.settings[label_key] != blank %}
          <p class="ai-process-{{ ai_gen_id }}__label">{{ block.settings[label_key] | escape }}</p>
        {% endif %}
        {% if block.settings[heading_key] != blank %}
          <h2 class="ai-process-{{ ai_gen_id }}__heading">{{ block.settings[heading_key] | escape }}</h2>
        {% endif %}
        {% if block.settings[description_key] != blank %}
          <p class="ai-process-{{ ai_gen_id }}__description">{{ block.settings[description_key] | escape }}</p>
        {% endif %}
      </article>
    {% endfor %}
  </div>
</div>

