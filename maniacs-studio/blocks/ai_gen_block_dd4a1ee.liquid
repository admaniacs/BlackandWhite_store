{% doc %}
  @prompt
    Create a custom Eyebrow text
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-eyebrow-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0;
    color: {{ block.settings.text_color }};
    font-family: {{ settings.type_subheading_font.family }}, {{ settings.type_subheading_font.fallback_families }};
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ settings.type_subheading_font.weight }};
    line-height: 1.4;
    letter-spacing: {{ block.settings.letter_spacing }}px;
    text-transform: {{ block.settings.text_case }};
    text-align: {{ block.settings.alignment }};
  }
{% endstyle %}

{% if block.settings.eyebrow_text != blank %}
  <p class="ai-eyebrow-{{ ai_gen_id }}" {{ block.shopify_attributes }}>{{ block.settings.eyebrow_text | escape }}</p>
{% else %}
  <p class="ai-eyebrow-{{ ai_gen_id }}" {{ block.shopify_attributes }}>Add eyebrow text in the block settings</p>
{% endif %}

{% schema %}
{
  "name": "Eyebrow text",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Text",
      "default": "New collection"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 1
    },
    {
      "type": "select",
      "id": "text_case",
      "label": "Text case",
      "options": [
        { "value": "none", "label": "Default" },
        { "value": "uppercase", "label": "Uppercase" }
      ],
      "default": "uppercase"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Eyebrow text"
    }
  ],
  "tag": null,
  "class": "eyebrow-text-block"
}
{% endschema %}