{% doc %}
  @prompt
    Create a custom block called 'Vote Option' for my Shopify theme that I can add multiple times within a section to display a voting/poll results list, similar to a horizontal bar chart.
    
    Block structure (each row):
    
    Container — a horizontal bar/row with a thin outlined border, dark green background (
    #0F3D2E or similar), full width
    Fill bar — a lighter green fill inside the container that extends from the left edge, with its width representing the vote percentage (editable percentage field per block, e.g., 39%). The fill should only cover part of the row (proportional to the percentage), with the remaining space showing the darker background
    Label text — left-aligned, bold, white text showing the option name (e.g., 'Food & drink') — editable text field
    Percentage text — right-aligned, bold, white text showing the percentage (e.g., '39%') — this can be auto-calculated from votes if a voting mechanism is connected, or manually editable as a static field
    
    Design requirements:
    
    Rows stacked vertically with small gaps between them (roughly 8-12px)
    Each row has consistent height (approximately 50-60px)
    Rounded or sharp corners on each row — keep border-radius minimal (4-6px)
    White/cream border outline around each row, subtle (1px)
    Bold sans-serif font for both label and percentage
    The row with the highest percentage should support an optional 'highlighted' state — brighter border or slightly lighter background to visually indicate the leading option (see reference: first row has a more visible white border than the others)
    Responsive — rows should remain readable and properly proportioned on mobile, font size scaling down slightly if needed
    
    Functionality:
    
    Set this up as a block type within a section so I can add, remove, and reorder multiple 'Vote Option' blocks (as many as needed) directly from the theme customizer
    Each block should have editable fields for: option label, percentage value, and a toggle for 'highlighted/leading' state
    If possible, structure the percentage field so the fill-bar width is dynamically generated based on the percentage value entered (e.g., using inline CSS width tied to the metafield/setting)
    
    This will be used as a voting results display — like a poll where customers can see which product category or theme direction is most popular
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-vote-option-{{ ai_gen_id }} {
    display: block;
    box-sizing: border-box;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-vote-option-{{ ai_gen_id }}__row {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    box-sizing: border-box;
    width: 100%;
    min-height: 56px;
    padding: 12px 16px;
    overflow: hidden;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.corner_radius }}px;
    background: {{ block.settings.bar_color }};
    color: {{ block.settings.text_color }};
    font-family: sans-serif;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.3;
  }

  .ai-vote-option-{{ ai_gen_id }}__row--highlighted {
    border-color: {{ block.settings.highlight_border_color }};
    background-color: {{ block.settings.highlight_background }};
  }

  .ai-vote-option-{{ ai_gen_id }}__fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: {{ block.settings.percentage }}%;
    background-color: {{ block.settings.fill_color }};
    opacity: 0.9;
    pointer-events: none;
  }

  .ai-vote-option-{{ ai_gen_id }}__label,
  .ai-vote-option-{{ ai_gen_id }}__percentage {
    position: relative;
    z-index: 1;
    color: {{ block.settings.text_color }};
  }

  .ai-vote-option-{{ ai_gen_id }}__label {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .ai-vote-option-{{ ai_gen_id }}__percentage {
    flex: 0 0 auto;
    white-space: nowrap;
  }

  @media screen and (max-width: 749px) {
    .ai-vote-option-{{ ai_gen_id }}__row {
      min-height: 50px;
      gap: 10px;
      padding: 10px 12px;
      font-size: 14px;
    }
  }
{% endstyle %}

<div class="ai-vote-option-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div
    class="ai-vote-option-{{ ai_gen_id }}__row{% if block.settings.highlighted %} ai-vote-option-{{ ai_gen_id }}__row--highlighted{% endif %}"
    role="img"
    aria-label="{{ block.settings.option_label | escape }}: {{ block.settings.percentage }}%"
  >
    <span class="ai-vote-option-{{ ai_gen_id }}__fill" aria-hidden="true"></span>
    <span class="ai-vote-option-{{ ai_gen_id }}__label">{{ block.settings.option_label | escape }}</span>
    <span class="ai-vote-option-{{ ai_gen_id }}__percentage">{{ block.settings.percentage }}%</span>
  </div>
</div>

{% schema %}
{
  "name": "Vote Option",
  "settings": [
    {
      "type": "text",
      "id": "option_label",
      "label": "Option label",
      "default": "Food & drink"
    },
    {
      "type": "range",
      "id": "percentage",
      "label": "Percentage",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 39
    },
    {
      "type": "checkbox",
      "id": "highlighted",
      "label": "Highlight leading option",
      "default": false
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bar_color",
      "label": "Row background",
      "default": "#0F3D2E"
    },
    {
      "type": "color",
      "id": "fill_color",
      "label": "Vote fill",
      "default": "#287A57"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#D9E5DD"
    },
    {
      "type": "color",
      "id": "highlight_border_color",
      "label": "Highlighted border",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "highlight_background",
      "label": "Highlighted background",
      "default": "#174B39"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 5
    }
  ],
  "presets": [
    {
      "name": "Vote Option"
    }
  ],
  "tag": null,
  "class": "vote-option-block"
}
{% endschema %}