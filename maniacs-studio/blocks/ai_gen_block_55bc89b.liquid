{% doc %}
  @prompt
    create a time countdown block, add a option to make background opACITY DECREASE
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-countdown-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 24px;
    color: {{ block.settings.text_color }};
    background-color: {{ block.settings.background_color }};
    background-color: {{ block.settings.background_color | color_modify: 'alpha', block.settings.background_opacity | divided_by: 100.0 }};
    border: 1px solid {{ block.settings.text_color }};
    text-align: center;
  }
  .ai-countdown-{{ ai_gen_id }}__heading {
    margin: 0 0 18px;
    color: inherit;
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: clamp(24px, 4vw, 40px);
    line-height: 1.15;
  }
  .ai-countdown-{{ ai_gen_id }}__timer {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .ai-countdown-{{ ai_gen_id }}__unit {
    min-width: 76px;
    padding: 12px 10px;
    border: 1px solid currentColor;
  }
  .ai-countdown-{{ ai_gen_id }}__value {
    display: block;
    font-size: clamp(24px, 5vw, 36px);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .ai-countdown-{{ ai_gen_id }}__label {
    display: block;
    margin-top: 8px;
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .ai-countdown-{{ ai_gen_id }}__message { margin: 16px 0 0; }
  @media screen and (max-width: 480px) {
    .ai-countdown-{{ ai_gen_id }} { padding: 20px 12px; }
    .ai-countdown-{{ ai_gen_id }}__timer { gap: 6px; }
    .ai-countdown-{{ ai_gen_id }}__unit { min-width: 62px; padding: 10px 6px; }
  }
{% endstyle %}

<countdown-timer-{{ ai_gen_id }} class="ai-countdown-{{ ai_gen_id }}" data-target="{{ block.settings.target_date | escape }}" data-expired="{{ block.settings.expired_message | escape }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}<h2 class="ai-countdown-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
  <div class="ai-countdown-{{ ai_gen_id }}__timer" role="timer" aria-live="off" aria-label="Countdown">
    <div class="ai-countdown-{{ ai_gen_id }}__unit"><span class="ai-countdown-{{ ai_gen_id }}__value" data-days>00</span><span class="ai-countdown-{{ ai_gen_id }}__label">Days</span></div>
    <div class="ai-countdown-{{ ai_gen_id }}__unit"><span class="ai-countdown-{{ ai_gen_id }}__value" data-hours>00</span><span class="ai-countdown-{{ ai_gen_id }}__label">Hours</span></div>
    <div class="ai-countdown-{{ ai_gen_id }}__unit"><span class="ai-countdown-{{ ai_gen_id }}__value" data-minutes>00</span><span class="ai-countdown-{{ ai_gen_id }}__label">Minutes</span></div>
    <div class="ai-countdown-{{ ai_gen_id }}__unit"><span class="ai-countdown-{{ ai_gen_id }}__value" data-seconds>00</span><span class="ai-countdown-{{ ai_gen_id }}__label">Seconds</span></div>
  </div>
  <p class="ai-countdown-{{ ai_gen_id }}__message" data-message hidden></p>
</countdown-timer-{{ ai_gen_id }}>

<script>
  (() => {
    const tagName = 'countdown-timer-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class CountdownTimer extends HTMLElement {
      connectedCallback() {
        if (this.interval) window.clearInterval(this.interval);
        this.target = new Date(this.dataset.target).getTime();
        this.message = this.querySelector('[data-message]');
        this.tick();
        if (Number.isFinite(this.target) && this.target > Date.now()) this.interval = window.setInterval(() => this.tick(), 1000);
      }
      disconnectedCallback() {
        if (this.interval) window.clearInterval(this.interval);
      }
      tick() {
        const remaining = this.target - Date.now();
        if (!Number.isFinite(remaining) || remaining <= 0) {
          this.querySelector('.ai-countdown-{{ ai_gen_id }}__timer').hidden = true;
          this.message.textContent = this.dataset.expired || 'The countdown has ended.';
          this.message.hidden = false;
          if (this.interval) window.clearInterval(this.interval);
          return;
        }
        const seconds = Math.floor(remaining / 1000);
        this.querySelector('[data-days]').textContent = String(Math.floor(seconds / 86400)).padStart(2, '0');
        this.querySelector('[data-hours]').textContent = String(Math.floor((seconds % 86400) / 3600)).padStart(2, '0');
        this.querySelector('[data-minutes]').textContent = String(Math.floor((seconds % 3600) / 60)).padStart(2, '0');
        this.querySelector('[data-seconds]').textContent = String(seconds % 60).padStart(2, '0');
      }
    }
    customElements.define(tagName, CountdownTimer);
  })();
</script>

{% schema %}
{
  "name": "Time countdown",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Coming soon" },
    { "type": "text", "id": "target_date", "label": "Target date and time", "default": "2027-01-01T00:00:00+05:30", "info": "Use ISO format with timezone, for example 2027-01-01T00:00:00+05:30." },
    { "type": "text", "id": "expired_message", "label": "After countdown", "default": "The countdown has ended." },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "text_color", "label": "Text and border", "default": "#000000" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "range", "id": "background_opacity", "label": "Background opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "Time countdown" }],
  "tag": null,
  "class": "time-countdown-block"
}
{% endschema %}