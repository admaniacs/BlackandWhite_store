{% doc %}
  @prompt
    Generate a custom footer section with single menu section and the there is no need of title just list the menus horizontally
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-menu-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.vertical_padding }}px 24px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    box-sizing: border-box;
  }

  .ai-footer-menu-{{ ai_gen_id }}__inner {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .ai-footer-menu-{{ ai_gen_id }}__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: {{ block.settings.link_gap }}px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ai-footer-menu-{{ ai_gen_id }}__link {
    color: inherit;
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
    text-decoration: none;
    text-underline-offset: 0.2em;
  }

  .ai-footer-menu-{{ ai_gen_id }}__link:hover {
    text-decoration: underline;
  }

  .ai-footer-menu-{{ ai_gen_id }}__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
    border-radius: 2px;
  }

  .ai-footer-menu-{{ ai_gen_id }}__empty {
    margin: 0;
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
    opacity: 0.75;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-footer-menu-{{ ai_gen_id }} {
      width: 100%;
      padding-right: 16px;
      padding-left: 16px;
    }

    .ai-footer-menu-{{ ai_gen_id }}__list {
      column-gap: {{ block.settings.link_gap | times: 0.7 }}px;
      row-gap: 10px;
    }
  }
{% endstyle %}

<div class="ai-footer-menu-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <nav class="ai-footer-menu-{{ ai_gen_id }}__inner" aria-label="Footer navigation">
    {% if block.settings.menu != blank and block.settings.menu.links.size > 0 %}
      <ul class="ai-footer-menu-{{ ai_gen_id }}__list">
        {% for link in block.settings.menu.links %}
          <li>
            <a class="ai-footer-menu-{{ ai_gen_id }}__link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="ai-footer-menu-{{ ai_gen_id }}__empty">Choose a menu to display footer links.</p>
    {% endif %}
  </nav>
</div>

{% schema %}
{
  "name": "Footer menu links",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "link_gap",
      "label": "Link spacing",
      "min": 12,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Vertical padding",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Footer menu links"
    }
  ],
  "tag": null,
  "class": "footer-menu-links"
}
{% endschema %}