{% doc %}
  @prompt
    Create a custom block called 'Roadmap Card' for my Shopify theme that I can add multiple times within a section to display a 3-column grid of 'what's coming next' cards.
    
    Block structure (top to bottom):
    
    Image area — a fixed-height image container where the uploaded photo fills the entire frame edge-to-edge (object-fit: cover), with no cropping of key subject matter — center the focal point of the image within the container. This area should be visually separate from the text content below it.
    Overlay on the image (positioned on top of the photo):
    Large index number (e.g., 02, 03, 04) in a serif font, top-left
    Status badge in the top-right corner with an outlined/bordered style (e.g., 'IN BUILD', 'SKETCHING', 'YOU DECIDE') — editable text field per block
    Text area below the image (NOT overlapping it — clear separation with padding):
    A codename-style title (e.g., 'Codename "Ember"') in a serif italic font
    A short one-line description directly below the title
    Progress tracker at the bottom of the block:
    A thin progress bar/line that visually fills based on how far along the item is (editable percentage per block)
    4-step horizontal labels underneath: Sketch → Build → Test → Launch
    
    Design requirements:
    
    Dark green background (
    #0F3D2E or similar) for the block body
    White/cream text for contrast
    Sharp or slightly rounded corners, minimal border
    Adequate padding between the image area and text area so they never visually collide
    Each block should have its own editable settings (image, title, description, status badge text, progress step)
    Responsive — image container height should scale proportionally on smaller screens
    
    Set this up as a block type within a section so I can add, remove, and reorder multiple 'Roadmap Card' blocks (3-4 of them) directly from the theme customizer, arranged in a grid, i need 3 of this in a row with Square frame
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-roadmap-card-{{ ai_gen_id }} { display:block; width:{{ block.settings.desktop_width_percent }}%; max-width:100%; overflow:hidden; background:{{ block.settings.card_background }}; color:{{ block.settings.text_color }}; border:1px solid rgba(255,255,255,.16); border-radius:2px; }
  .ai-roadmap-card-{{ ai_gen_id }}__media { position:relative; width:100%; aspect-ratio:1 / 1; overflow:hidden; background:#1a4b3b; }
  .ai-roadmap-card-{{ ai_gen_id }}__media img, .ai-roadmap-card-{{ ai_gen_id }}__placeholder svg { display:block; width:100%; height:100%; object-fit:cover; object-position:center center; }
  .ai-roadmap-card-{{ ai_gen_id }}__placeholder { width:100%; height:100%; }
  .ai-roadmap-card-{{ ai_gen_id }}__placeholder svg { background:#244d40; color:#e9e5d9; }
  .ai-roadmap-card-{{ ai_gen_id }}__image-shade { position:absolute; inset:0; background:linear-gradient(180deg,rgba(0,0,0,.42),transparent 42%); pointer-events:none; }
  .ai-roadmap-card-{{ ai_gen_id }}__index { position:absolute; z-index:1; top:16px; left:18px; color:#fffdf5; font-family:{{ settings.type_heading_font.family }},serif; font-size:clamp(30px,4vw,48px); line-height:1; font-weight:400; text-shadow:0 1px 8px rgba(0,0,0,.4); }
  .ai-roadmap-card-{{ ai_gen_id }}__badge { position:absolute; z-index:1; top:18px; right:18px; max-width:calc(100% - 100px); padding:7px 10px; border:1px solid #fffdf5; color:#fffdf5; background:rgba(15,61,46,.72); font-family:{{ settings.type_body_font.family }},sans-serif; font-size:10px; font-weight:600; letter-spacing:.12em; line-height:1.2; text-transform:uppercase; overflow-wrap:anywhere; }
  .ai-roadmap-card-{{ ai_gen_id }}__content { display:flex; flex-direction:column; min-height:224px; padding:22px 22px 20px; }
  .ai-roadmap-card-{{ ai_gen_id }}__title { margin:0 0 8px; color:{{ block.settings.text_color }}; font-family:{{ settings.type_accent_font.family }},serif; font-size:clamp(23px,2.4vw,30px); font-style:italic; font-weight:400; line-height:1.15; }
  .ai-roadmap-card-{{ ai_gen_id }}__description { margin:0; color:{{ block.settings.text_color }}; font-family:{{ settings.type_body_font.family }},sans-serif; font-size:13px; line-height:1.55; opacity:.88; }
  .ai-roadmap-card-{{ ai_gen_id }}__progress-area { margin-top:auto; padding-top:28px; }
  .ai-roadmap-card-{{ ai_gen_id }}__track { height:2px; width:100%; background:rgba(255,253,245,.3); }
  .ai-roadmap-card-{{ ai_gen_id }}__fill { display:block; height:100%; width:{{ block.settings.progress }}%; background:{{ block.settings.progress_color }}; }
  .ai-roadmap-card-{{ ai_gen_id }}__steps { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:4px; margin-top:11px; color:{{ block.settings.text_color }}; font-family:{{ settings.type_body_font.family }},sans-serif; font-size:10px; line-height:1.3; }
  .ai-roadmap-card-{{ ai_gen_id }}__steps span { opacity:.78; }
  .ai-roadmap-card-{{ ai_gen_id }}__steps span:last-child { text-align:right; }
  @media screen and (max-width:749px) { .ai-roadmap-card-{{ ai_gen_id }} { width:100%; } .ai-roadmap-card-{{ ai_gen_id }}__content { min-height:210px; padding:20px 18px 18px; } .ai-roadmap-card-{{ ai_gen_id }}__steps { grid-template-columns:repeat(2,minmax(0,1fr)); row-gap:6px; font-size:11px; } .ai-roadmap-card-{{ ai_gen_id }}__badge { font-size:11px; } }
{% endstyle %}
<div class="ai-roadmap-card-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-roadmap-card-{{ ai_gen_id }}__media">
    {% if block.settings.image != blank %}<img src="{{ block.settings.image | image_url: width: 1400 }}" alt="{{ block.settings.image.alt | default: block.settings.title | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">{% else %}<div class="ai-roadmap-card-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}
    <span class="ai-roadmap-card-{{ ai_gen_id }}__image-shade" aria-hidden="true"></span>
    <span class="ai-roadmap-card-{{ ai_gen_id }}__index">{{ block.settings.index_number | escape }}</span>
    {% if block.settings.status != blank %}<span class="ai-roadmap-card-{{ ai_gen_id }}__badge">{{ block.settings.status | escape }}</span>{% endif %}
  </div>
  <div class="ai-roadmap-card-{{ ai_gen_id }}__content">
    {% if block.settings.title != blank %}<h3 class="ai-roadmap-card-{{ ai_gen_id }}__title">{{ block.settings.title | escape }}</h3>{% endif %}
    {% if block.settings.description != blank %}<p class="ai-roadmap-card-{{ ai_gen_id }}__description">{{ block.settings.description | escape }}</p>{% endif %}
    <div class="ai-roadmap-card-{{ ai_gen_id }}__progress-area">
      <div class="ai-roadmap-card-{{ ai_gen_id }}__track" role="progressbar" aria-label="{{ block.settings.title | default: 'Roadmap item' | escape }} progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ block.settings.progress }}"><span class="ai-roadmap-card-{{ ai_gen_id }}__fill"></span></div>
      <div class="ai-roadmap-card-{{ ai_gen_id }}__steps" aria-hidden="true"><span>Sketch</span><span>Build</span><span>Test</span><span>Launch</span></div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Roadmap card",
  "settings": [
    {"type":"header","content":"Card content"},
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"text","id":"index_number","label":"Index number","default":"02"},
    {"type":"text","id":"status","label":"Status badge","default":"IN BUILD"},
    {"type":"text","id":"title","label":"Title","default":"Codename “Ember”"},
    {"type":"text","id":"description","label":"Description","default":"A considered detail, made for what comes next."},
    {"type":"range","id":"progress","label":"Progress","min":0,"max":100,"step":5,"unit":"%","default":50},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"header","content":"Colors"},
    {"type":"color","id":"card_background","label":"Background","default":"#0F3D2E"},
    {"type":"color","id":"text_color","label":"Text","default":"#F7F4E9"},
    {"type":"color","id":"progress_color","label":"Progress line","default":"#F7F4E9"}
  ],
  "presets": [{"name":"Roadmap card"}],
  "tag": null,
  "class": "roadmap-card-block"
}
{% endschema %}