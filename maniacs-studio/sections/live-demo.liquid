{%- liquid
  assign sid = section.id | replace: '_', '' | downcase
  assign demo_url = section.settings.demo_url | default: 'https://black-and-white-8fiua40n.myshopify.com/'
-%}

{% style %}
  .live-demo-{{ sid }} {
    background: {{ section.settings.stage_color }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding_top }}px 16px {{ section.settings.padding_bottom }}px;
  }
  .live-demo-{{ sid }} * { box-sizing: border-box; }
  .live-demo-{{ sid }}__inner { max-width: 1200px; margin: 0 auto; }
  .live-demo-{{ sid }}__head { text-align: center; margin-bottom: 20px; }
  .live-demo-{{ sid }}__eyebrow { margin: 0 0 6px; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; opacity: .75; }
  .live-demo-{{ sid }}__heading { margin: 0; color: inherit; font-size: clamp(26px, 4vw, 44px); line-height: 1.1; }

  .live-demo-{{ sid }}__toggle { display: flex; justify-content: center; gap: 6px; margin: 0 0 20px; }
  .live-demo-{{ sid }}__toggle button {
    display: inline-flex; align-items: center; gap: 8px;
    min-height: 44px; padding: 0 16px;
    border: 1px solid currentColor; border-radius: 999px;
    background: transparent; color: inherit; font: inherit; font-size: 14px;
    cursor: pointer; opacity: .6; transition: opacity .2s, background .2s, color .2s;
  }
  .live-demo-{{ sid }}__toggle button[aria-pressed="true"] {
    opacity: 1; background: {{ section.settings.text_color }}; color: {{ section.settings.stage_color }};
  }
  .live-demo-{{ sid }}__toggle svg { width: 18px; height: 18px; }

  .live-demo-{{ sid }}__stage { display: flex; justify-content: center; }

  .live-demo-{{ sid }}__frame {
    position: relative; overflow: hidden; background: #fff;
    box-shadow: 0 20px 60px rgba(0,0,0,.35);
  }
  .live-demo-{{ sid }}__screen {
    height: 100%; overflow-y: auto; overscroll-behavior: contain;
    scrollbar-width: thin; -webkit-overflow-scrolling: touch;
  }
  .live-demo-{{ sid }}__screen img { display: block; width: 100%; height: auto; }
  .live-demo-{{ sid }}__empty {
    height: 100%; display: grid; place-items: center; padding: 24px;
    color: #555; background: #f4f4f1; font-size: 14px; text-align: center;
  }

  .live-demo-{{ sid }}__view { display: none; }
  .live-demo-{{ sid }}[data-view="desktop"] .live-demo-{{ sid }}__view--desktop,
  .live-demo-{{ sid }}[data-view="mobile"] .live-demo-{{ sid }}__view--mobile { display: block; }

  /* Desktop: browser window */
  .live-demo-{{ sid }}__view--desktop { width: 100%; height: {{ section.settings.desktop_height }}px; border-radius: 12px; }
  .live-demo-{{ sid }}__chrome {
    display: flex; align-items: center; gap: 6px; height: 32px; padding: 0 12px;
    background: #ececec; border-bottom: 1px solid #ddd;
  }
  .live-demo-{{ sid }}__chrome span { width: 10px; height: 10px; border-radius: 50%; background: #c9c9c9; }
  .live-demo-{{ sid }}__view--desktop .live-demo-{{ sid }}__screen { height: calc(100% - 32px); }

  /* Phone: device frame */
  .live-demo-{{ sid }}__view--mobile {
    width: 375px; max-width: 100%; height: min(760px, 80vh);
    border: 10px solid #1b1b1b; border-radius: 40px;
  }

  .live-demo-{{ sid }}__hint { margin: 10px 0 0; text-align: center; font-size: 13px; opacity: .6; }

  .live-demo-{{ sid }}__bar {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px;
    max-width: 1100px; margin: 20px auto 0; padding: 12px 12px 12px 24px;
    background: #fff; color: #111; border-radius: 999px;
  }
  .live-demo-{{ sid }}__name { margin: 0; font-size: 20px; font-weight: 600; }
  .live-demo-{{ sid }}__meta { margin-left: 10px; font-size: 14px; font-weight: 400; opacity: .65; }
  .live-demo-{{ sid }}__actions { display: flex; gap: 8px; }
  .live-demo-{{ sid }}__btn {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px;
    border: 1px solid #d0d0d0; border-radius: 999px; color: #111; text-decoration: none; font-size: 14px;
  }
  .live-demo-{{ sid }}__pass { gap: 8px; border-style: dashed; background: transparent; font: inherit; font-size: 13px; cursor: pointer; }
  .live-demo-{{ sid }}__pass-label { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; opacity: .6; }
  .live-demo-{{ sid }}__pass code { font-family: ui-monospace, Menlo, Consolas, monospace; font-weight: 600; }
  .live-demo-{{ sid }}__pass [data-copy-state] { padding: 4px 8px; background: #111; color: #fff; border-radius: 999px; font-size: 11px; text-transform: uppercase; letter-spacing: .08em; }
  .live-demo-{{ sid }}__btn--primary { background: {{ section.settings.button_color }}; border-color: {{ section.settings.button_color }}; color: #fff; }

  @media screen and (max-width: 749px) {
    .live-demo-{{ sid }}__view--desktop { height: 420px; }
    .live-demo-{{ sid }}__bar { border-radius: 20px; padding: 16px; justify-content: center; text-align: center; }
    .live-demo-{{ sid }}__actions { width: 100%; }
    .live-demo-{{ sid }}__btn { flex: 1; justify-content: center; }
  }
{% endstyle %}

<div class="live-demo-{{ sid }}" data-view="desktop" data-live-demo>
  <div class="live-demo-{{ sid }}__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="live-demo-{{ sid }}__head">
        {%- if section.settings.eyebrow != blank -%}<p class="live-demo-{{ sid }}__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="live-demo-{{ sid }}__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="live-demo-{{ sid }}__toggle" role="group" aria-label="Preview size">
      <button type="button" data-view-btn="desktop" aria-pressed="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M8 20h8M12 16v4"/></svg>
        Desktop
      </button>
      <button type="button" data-view-btn="mobile" aria-pressed="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="7" y="2.5" width="10" height="19" rx="2"/><path d="M11 18.5h2"/></svg>
        Phone
      </button>
    </div>

    <div class="live-demo-{{ sid }}__stage">
      <div class="live-demo-{{ sid }}__frame live-demo-{{ sid }}__view live-demo-{{ sid }}__view--desktop">
        <div class="live-demo-{{ sid }}__chrome" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="live-demo-{{ sid }}__screen" tabindex="0" aria-label="Desktop preview, scroll to explore">
          {%- if section.settings.desktop_image != blank -%}
            {{ section.settings.desktop_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '800, 1200, 1600', sizes: '(min-width: 1200px) 1200px, 100vw', alt: section.settings.desktop_image.alt }}
          {%- else -%}
            <div class="live-demo-{{ sid }}__empty">Add a full-page desktop screenshot in the section settings.</div>
          {%- endif -%}
        </div>
      </div>

      <div class="live-demo-{{ sid }}__frame live-demo-{{ sid }}__view live-demo-{{ sid }}__view--mobile">
        <div class="live-demo-{{ sid }}__screen" tabindex="0" aria-label="Phone preview, scroll to explore">
          {%- if section.settings.mobile_image != blank -%}
            {{ section.settings.mobile_image | image_url: width: 750 | image_tag: loading: 'lazy', widths: '375, 750', sizes: '375px', alt: section.settings.mobile_image.alt }}
          {%- else -%}
            <div class="live-demo-{{ sid }}__empty">Add a full-page phone screenshot in the section settings.</div>
          {%- endif -%}
        </div>
      </div>
    </div>

    <p class="live-demo-{{ sid }}__hint">Scroll inside the preview to explore the page.</p>

    <div class="live-demo-{{ sid }}__bar">
      <p class="live-demo-{{ sid }}__name">
        {{ section.settings.theme_name | escape }}
        {%- if section.settings.meta != blank -%}<span class="live-demo-{{ sid }}__meta">{{ section.settings.meta | escape }}</span>{%- endif -%}
      </p>
      <div class="live-demo-{{ sid }}__actions">
        {%- if section.settings.password != blank -%}
          <button type="button" class="live-demo-{{ sid }}__btn live-demo-{{ sid }}__pass" data-copy-pass="{{ section.settings.password | escape }}" aria-label="Copy demo password">
            <span class="live-demo-{{ sid }}__pass-label">Password</span>
            <code>{{ section.settings.password | escape }}</code>
            <span data-copy-state>Copy</span>
          </button>
        {%- endif -%}
        <a class="live-demo-{{ sid }}__btn" href="{{ demo_url }}" target="_blank" rel="noopener" data-open-demo>{{ section.settings.view_label | escape }} ↗</a>
        {%- if section.settings.buy_link != blank -%}
          <a class="live-demo-{{ sid }}__btn live-demo-{{ sid }}__btn--primary" href="{{ section.settings.buy_link }}">{{ section.settings.buy_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script>
  (() => {
    const root = document.currentScript.previousElementSibling;
    if (!root || !root.matches('[data-live-demo]')) return;
    const buttons = root.querySelectorAll('[data-view-btn]');
    const setView = (view) => {
      root.dataset.view = view;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.viewBtn === view)));
    };
    buttons.forEach((b) => b.addEventListener('click', () => setView(b.dataset.viewBtn)));
    if (window.matchMedia('(max-width: 749px)').matches) setView('mobile');
    const pass = root.querySelector('[data-copy-pass]');
    const copy = async () => {
      if (!pass) return;
      try { await navigator.clipboard.writeText(pass.dataset.copyPass); } catch (e) { return; }
      const state = pass.querySelector('[data-copy-state]');
      state.textContent = 'Copied';
      setTimeout(() => { state.textContent = 'Copy'; }, 1800);
    };
    pass?.addEventListener('click', copy);
    root.querySelector('[data-open-demo]')?.addEventListener('click', copy);
  })();
</script>

{% schema %}
{
  "name": "Live demo",
  "tag": "section",
  "class": "live-demo-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Try before you buy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See it live" },
    { "type": "header", "content": "Screenshots" },
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop full-page screenshot", "info": "A tall screenshot of the whole page at desktop width, e.g. 1440px wide." },
    { "type": "image_picker", "id": "mobile_image", "label": "Phone full-page screenshot", "info": "A tall screenshot of the whole page at phone width, e.g. 390px wide." },
    { "type": "header", "content": "Bar" },
    { "type": "url", "id": "demo_url", "label": "Demo store URL", "info": "Opened in a new tab by the View demo button." },
    { "type": "text", "id": "theme_name", "label": "Theme name", "default": "Black & White" },
    { "type": "text", "id": "meta", "label": "Small text next to name", "default": "Online Store 2.0" },
    { "type": "text", "id": "view_label", "label": "Open demo button", "default": "View demo" },
    { "type": "text", "id": "password", "label": "Demo password", "default": "Demo-BW", "info": "Shown next to the button and copied when visitors open the demo." },
    { "type": "url", "id": "buy_link", "label": "Buy button link" },
    { "type": "text", "id": "buy_label", "label": "Buy button text", "default": "Buy theme" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_height", "label": "Desktop preview height", "min": 400, "max": 900, "step": 20, "unit": "px", "default": 640 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "stage_color", "label": "Background", "default": "#121212" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "button_color", "label": "Buy button", "default": "#074F3B" }
  ],
  "presets": [{ "name": "Live demo" }]
}
{% endschema %}
