{%- liquid
  assign sid = section.id | replace: '_', '' | downcase
  assign review_blocks = section.blocks | where: 'type', 'review'
  assign total = review_blocks.size
  assign sum = 0
  assign c5 = 0
  assign c4 = 0
  assign c3 = 0
  assign c2 = 0
  assign c1 = 0
  for b in review_blocks
    assign r = b.settings.rating | plus: 0
    assign sum = sum | plus: r
    case r
      when 5
        assign c5 = c5 | plus: 1
      when 4
        assign c4 = c4 | plus: 1
      when 3
        assign c3 = c3 | plus: 1
      when 2
        assign c2 = c2 | plus: 1
      else
        assign c1 = c1 | plus: 1
    endcase
  endfor
  if total > 0
    assign avg = sum | times: 1.0 | divided_by: total | round: 1
  else
    assign avg = 0
  endif
  assign avg_pct = avg | times: 20
  assign initial = section.settings.initial_count
-%}

{% style %}
  .bw-reviews-{{ sid }} {
    --rv-ink: {{ section.settings.text_color }};
    --rv-accent: {{ section.settings.accent_color }};
    --rv-bg: {{ section.settings.background_color }};
    --rv-card: {{ section.settings.card_color }};
    background: var(--rv-bg);
    color: var(--rv-ink);
    padding: {{ section.settings.padding_top }}px 16px {{ section.settings.padding_bottom }}px;
  }
  .bw-reviews-{{ sid }} * { box-sizing: border-box; }
  .bw-reviews-{{ sid }}__inner { max-width: 1100px; margin: 0 auto; }
  .bw-reviews-{{ sid }}__eyebrow { margin: 0 0 6px; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--rv-accent); }
  .bw-reviews-{{ sid }}__heading { margin: 0 0 28px; color: inherit; font-size: clamp(28px, 4vw, 44px); line-height: 1.1; }

  .bw-reviews-{{ sid }}__layout { display: grid; grid-template-columns: minmax(240px, 320px) 1fr; gap: 48px; align-items: start; }

  /* Summary */
  .bw-reviews-{{ sid }}__summary { position: sticky; top: 24px; padding: 24px; background: var(--rv-card); border: 1px solid color-mix(in srgb, var(--rv-ink) 15%, transparent); }
  .bw-reviews-{{ sid }}__avg { display: flex; align-items: baseline; gap: 8px; margin: 0; }
  .bw-reviews-{{ sid }}__avg-num { font-size: 56px; line-height: 1; font-weight: 600; }
  .bw-reviews-{{ sid }}__avg-of { font-size: 16px; opacity: .8; }
  .bw-reviews-{{ sid }}__count { margin: 8px 0 20px; font-size: 14px; }

  .bw-reviews-{{ sid }}__stars { position: relative; display: inline-block; font-size: 20px; line-height: 1; letter-spacing: 2px; }
  .bw-reviews-{{ sid }}__stars::before { content: "★★★★★"; color: color-mix(in srgb, var(--rv-ink) 25%, transparent); }
  .bw-reviews-{{ sid }}__stars-fill { position: absolute; inset: 0 auto 0 0; overflow: hidden; white-space: nowrap; color: var(--rv-accent); }
  .bw-reviews-{{ sid }}__stars-fill::before { content: "★★★★★"; }
  .bw-reviews-{{ sid }}__stars--sm { font-size: 16px; }

  .bw-reviews-{{ sid }}__bars { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .bw-reviews-{{ sid }}__bar-btn {
    display: grid; grid-template-columns: 52px 1fr 28px; align-items: center; gap: 10px;
    width: 100%; min-height: 36px; padding: 4px 6px; border: 1px solid transparent;
    background: none; color: inherit; font: inherit; font-size: 14px; text-align: left; cursor: pointer;
  }
  .bw-reviews-{{ sid }}__bar-btn:hover { border-color: color-mix(in srgb, var(--rv-ink) 30%, transparent); }
  .bw-reviews-{{ sid }}__bar-btn[aria-pressed="true"] { border-color: var(--rv-accent); background: color-mix(in srgb, var(--rv-accent) 10%, transparent); }
  .bw-reviews-{{ sid }}__bar-btn:disabled { cursor: default; opacity: .55; }
  .bw-reviews-{{ sid }}__track { height: 8px; background: color-mix(in srgb, var(--rv-ink) 12%, transparent); }
  .bw-reviews-{{ sid }}__fill { display: block; height: 100%; background: var(--rv-accent); }
  .bw-reviews-{{ sid }}__clear { margin-top: 12px; padding: 0; border: 0; background: none; color: inherit; font: inherit; font-size: 14px; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }

  /* List */
  .bw-reviews-{{ sid }}__status { margin: 0 0 16px; font-size: 14px; }
  .bw-reviews-{{ sid }}__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .bw-reviews-{{ sid }}__item[hidden] { display: none; }
  .bw-reviews-{{ sid }}__card { padding: 24px; background: var(--rv-card); border: 1px solid color-mix(in srgb, var(--rv-ink) 15%, transparent); }
  .bw-reviews-{{ sid }}__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; margin-bottom: 10px; font-size: 14px; }
  .bw-reviews-{{ sid }}__title { margin: 0 0 8px; color: inherit; font-size: 18px; line-height: 1.3; }
  .bw-reviews-{{ sid }}__body { margin: 0; font-size: 16px; line-height: 1.6; }
  .bw-reviews-{{ sid }}__body p { margin: 0 0 8px; }
  .bw-reviews-{{ sid }}__author { margin-top: 14px; font-size: 14px; font-weight: 600; }
  .bw-reviews-{{ sid }}__badge {
    display: inline-flex; align-items: center; gap: 4px; padding: 3px 8px;
    border: 1px solid var(--rv-accent); color: var(--rv-accent); font-size: 12px; font-weight: 600;
  }
  .bw-reviews-{{ sid }}__more {
    display: inline-flex; align-items: center; justify-content: center; min-height: 48px; margin-top: 20px; padding: 0 24px;
    border: 1px solid var(--rv-ink); background: transparent; color: inherit; font: inherit; font-size: 14px;
    letter-spacing: .08em; text-transform: uppercase; cursor: pointer;
  }
  .bw-reviews-{{ sid }}__more:hover { background: var(--rv-ink); color: var(--rv-bg); }
  .bw-reviews-{{ sid }}__empty { margin: 0; padding: 24px; border: 1px dashed color-mix(in srgb, var(--rv-ink) 40%, transparent); }

  .bw-reviews-{{ sid }} :is(button, a):focus-visible { outline: 3px solid var(--rv-accent); outline-offset: 2px; }
  .bw-reviews-{{ sid }} .visually-hidden { position: absolute !important; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  @media (prefers-reduced-motion: no-preference) {
    .bw-reviews-{{ sid }}__fill { transition: width .4s ease; }
  }
  @media screen and (max-width: 749px) {
    .bw-reviews-{{ sid }}__layout { grid-template-columns: 1fr; gap: 24px; }
    .bw-reviews-{{ sid }}__summary { position: static; }
    .bw-reviews-{{ sid }}__card { padding: 18px; }
    .bw-reviews-{{ sid }}__more { width: 100%; }
  }
{% endstyle %}

{%- if total == 0 and request.design_mode == false -%}{%- else -%}
<section class="bw-reviews-{{ sid }}" aria-labelledby="bw-reviews-heading-{{ sid }}" data-bw-reviews data-initial="{{ initial }}">
  <div class="bw-reviews-{{ sid }}__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="bw-reviews-{{ sid }}__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h2 id="bw-reviews-heading-{{ sid }}" class="bw-reviews-{{ sid }}__heading">{{ section.settings.heading | escape }}</h2>

    {%- if total == 0 -%}
      <p class="bw-reviews-{{ sid }}__empty">No reviews yet. Click "Add block → Review" to add one. This message is only visible in the theme editor.</p>
    {%- else -%}
      <div class="bw-reviews-{{ sid }}__layout">
        <div class="bw-reviews-{{ sid }}__summary">
          <p class="bw-reviews-{{ sid }}__avg">
            <span class="bw-reviews-{{ sid }}__avg-num">{{ avg }}</span>
            <span class="bw-reviews-{{ sid }}__avg-of">out of 5</span>
          </p>
          <span class="bw-reviews-{{ sid }}__stars" role="img" aria-label="Average rating {{ avg }} out of 5 stars">
            <span class="bw-reviews-{{ sid }}__stars-fill" style="width: {{ avg_pct }}%;" aria-hidden="true"></span>
          </span>
          <p class="bw-reviews-{{ sid }}__count">Based on {{ total }} {% if total == 1 %}review{% else %}reviews{% endif %}</p>

          <h3 class="visually-hidden" id="bw-reviews-filter-{{ sid }}">Filter reviews by star rating</h3>
          <ul class="bw-reviews-{{ sid }}__bars" aria-labelledby="bw-reviews-filter-{{ sid }}">
            {%- for star in (1..5) reversed -%}
              {%- liquid
                case star
                  when 5
                    assign n = c5
                  when 4
                    assign n = c4
                  when 3
                    assign n = c3
                  when 2
                    assign n = c2
                  else
                    assign n = c1
                endcase
                assign pct = n | times: 100 | divided_by: total
              -%}
              <li>
                <button
                  type="button"
                  class="bw-reviews-{{ sid }}__bar-btn"
                  data-filter="{{ star }}"
                  aria-pressed="false"
                  {% if n == 0 %}disabled{% endif %}
                  aria-label="Show {{ star }} star reviews only, {{ n }} {% if n == 1 %}review{% else %}reviews{% endif %}"
                >
                  <span aria-hidden="true">{{ star }} ★</span>
                  <span class="bw-reviews-{{ sid }}__track" aria-hidden="true"><span class="bw-reviews-{{ sid }}__fill" style="width: {{ pct }}%;"></span></span>
                  <span aria-hidden="true">{{ n }}</span>
                </button>
              </li>
            {%- endfor -%}
          </ul>
          <button type="button" class="bw-reviews-{{ sid }}__clear" data-clear hidden>Show all reviews</button>
        </div>

        <div>
          <p class="bw-reviews-{{ sid }}__status" role="status" aria-live="polite" data-status>
            Showing {{ total | at_most: initial }} of {{ total }} {% if total == 1 %}review{% else %}reviews{% endif %}
          </p>
          <ul class="bw-reviews-{{ sid }}__list" id="bw-reviews-list-{{ sid }}" data-list>
            {%- for block in review_blocks -%}
              {%- assign r = block.settings.rating | plus: 0 -%}
              <li class="bw-reviews-{{ sid }}__item" data-rating="{{ r }}" {% if forloop.index > initial %}hidden{% endif %} {{ block.shopify_attributes }}>
                <article class="bw-reviews-{{ sid }}__card" aria-labelledby="bw-review-{{ block.id }}">
                  <div class="bw-reviews-{{ sid }}__meta">
                    <span class="bw-reviews-{{ sid }}__stars bw-reviews-{{ sid }}__stars--sm" role="img" aria-label="Rated {{ r }} out of 5 stars">
                      <span class="bw-reviews-{{ sid }}__stars-fill" style="width: {{ r | times: 20 }}%;" aria-hidden="true"></span>
                    </span>
                    {%- if block.settings.verified -%}
                      <span class="bw-reviews-{{ sid }}__badge"><span aria-hidden="true">✓</span> Verified buyer</span>
                    {%- endif -%}
                    {%- if block.settings.date != blank -%}
                      <span>{{ block.settings.date | escape }}</span>
                    {%- endif -%}
                  </div>
                  <h3 id="bw-review-{{ block.id }}" class="bw-reviews-{{ sid }}__title">{{ block.settings.title | escape }}</h3>
                  <div class="bw-reviews-{{ sid }}__body">{{ block.settings.body }}</div>
                  <p class="bw-reviews-{{ sid }}__author">
                    {{ block.settings.author | escape }}
                    {%- if block.settings.store != blank -%}<span style="font-weight:400;"> · {{ block.settings.store | escape }}</span>{%- endif -%}
                  </p>
                </article>
              </li>
            {%- endfor -%}
          </ul>
          {%- if total > initial -%}
            <button type="button" class="bw-reviews-{{ sid }}__more" data-more aria-controls="bw-reviews-list-{{ sid }}">Show more reviews</button>
          {%- endif -%}
        </div>
      </div>

      {%- if closest.product and section.settings.structured_data -%}
        <script type="application/ld+json">
          {
            "@context": "https://schema.org",
            "@type": "Product",
            "name": {{ closest.product.title | json }},
            "aggregateRating": {
              "@type": "AggregateRating",
              "ratingValue": {{ avg | json }},
              "reviewCount": {{ total }},
              "bestRating": 5,
              "worstRating": 1
            }
          }
        </script>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>
{%- endif -%}

<script>
  (() => {
    const root = document.currentScript.previousElementSibling;
    if (!root || !root.matches('[data-bw-reviews]')) return;
    const list = root.querySelector('[data-list]');
    if (!list) return;
    const items = Array.from(list.children);
    const status = root.querySelector('[data-status]');
    const more = root.querySelector('[data-more]');
    const clear = root.querySelector('[data-clear]');
    const filters = root.querySelectorAll('[data-filter]');
    const step = parseInt(root.dataset.initial, 10) || 4;
    let limit = step;
    let rating = null;

    const render = (focusFirstNew) => {
      const matching = items.filter((li) => rating === null || li.dataset.rating === String(rating));
      const before = matching.filter((li) => !li.hidden).length;
      items.forEach((li) => { li.hidden = true; });
      matching.forEach((li, i) => { li.hidden = i >= limit; });
      const shown = Math.min(limit, matching.length);
      const label = rating === null ? '' : ' with ' + rating + ' ' + (rating === 1 ? 'star' : 'stars');
      status.textContent = 'Showing ' + shown + ' of ' + matching.length + ' ' + (matching.length === 1 ? 'review' : 'reviews') + label;
      if (more) more.hidden = shown >= matching.length;
      if (clear) clear.hidden = rating === null;
      if (focusFirstNew && matching[before]) {
        const article = matching[before].querySelector('article');
        article.setAttribute('tabindex', '-1');
        article.focus();
      }
    };

    more?.addEventListener('click', () => { limit += step; render(true); });
    filters.forEach((btn) => btn.addEventListener('click', () => {
      const value = parseInt(btn.dataset.filter, 10);
      rating = rating === value ? null : value;
      filters.forEach((b) => b.setAttribute('aria-pressed', String(rating !== null && b === btn)));
      limit = step;
      render(false);
    }));
    clear?.addEventListener('click', () => {
      rating = null;
      filters.forEach((b) => b.setAttribute('aria-pressed', 'false'));
      limit = step;
      render(false);
      filters[0]?.focus();
    });
  })();
</script>

{% schema %}
{
  "name": "Reviews",
  "tag": "div",
  "class": "bw-reviews-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Loved by store owners" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What customers say" },
    { "type": "range", "id": "initial_count", "label": "Reviews shown before \"Show more\"", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "structured_data", "label": "Show star rating in Google results", "default": false, "info": "Only turn on when every review here is from a real customer." },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#E9F2EE" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#14231D" },
    { "type": "color", "id": "accent_color", "label": "Stars and accents", "default": "#074F3B", "info": "Keep this dark enough to read on the card background." },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "select", "id": "rating", "label": "Rating", "default": "5", "options": [
          { "value": "5", "label": "5 stars" },
          { "value": "4", "label": "4 stars" },
          { "value": "3", "label": "3 stars" },
          { "value": "2", "label": "2 stars" },
          { "value": "1", "label": "1 star" }
        ] },
        { "type": "text", "id": "title", "label": "Review title", "default": "Review title" },
        { "type": "richtext", "id": "body", "label": "Review", "default": "<p>Paste the customer's review here.</p>" },
        { "type": "text", "id": "author", "label": "Name", "default": "Customer name" },
        { "type": "text", "id": "store", "label": "Store or location" },
        { "type": "text", "id": "date", "label": "Date", "info": "e.g. September 2026" },
        { "type": "checkbox", "id": "verified", "label": "Verified buyer", "default": false, "info": "Tick only if this person bought the theme." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews"
    }
  ]
}
{% endschema %}
