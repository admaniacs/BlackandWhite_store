da"]},"accordion_row_iJM37V":{"type":"_accordion-row","settings":{"heading":"Installation Guide","open_by_default":false,"icon":"none","width":20},"blocks":{"text_VdG98J":{"type":"text","settings":{"text":"<h1>Theme Installation Guide</h1><p>Follow the steps below to get it installed and live on your store.</p><h2>What's Included</h2><ul><li>Theme file (.zip)</li><li>This installation guide</li><li>5 months of support (if purchased with the setup package)</li></ul><h2>Step 1: Download the Theme File</h2><p>After checkout, you'll receive an email with a download link to your theme's .zip file. Save it somewhere easy to find — you won't need to unzip it.</p><h2>Step 2: Log In to Your Shopify Admin</h2><p>Go to <strong>admin.shopify.com</strong> and log in to the store where you want to install the theme.</p><h2>Step 3: Upload the Theme</h2><ol><li>From your Shopify admin, go to <strong>Online Store &gt; Themes</strong>.</li><li>Scroll to the <strong>Theme Library</strong> section.</li><li>Click <strong>Add theme &gt; Upload zip file</strong>.</li><li>Select the .zip file you downloaded and click <strong>Upload</strong>.</li></ol><p>The theme will now appear in your Theme Library as unpublished.</p><h2>Step 4: Preview Before Publishing</h2><p>Click <strong>Preview</strong> on the newly uploaded theme to see how it looks before making it live. This lets you check everything renders correctly with your current products and content.</p><h2>Step 5: Customize the Theme</h2><ol><li>Click <strong>Customize</strong> on the theme.</li><li>Use the theme editor to:<br/><br/>Upload your logo<br/>Set your brand colors and fonts<br/>Edit homepage sections (banner, featured collections, etc.)<br/>Update menus and footer content<br/><br/><br/></li><li>Save your changes as you go.</li></ol><h2>Step 6: Publish the Theme</h2><p>Once you're happy with how it looks:</p><ol><li>Go back to <strong>Online Store &gt; Themes</strong>.</li><li>Click the <strong>⋯</strong> menu next to your customized theme.</li><li>Select <strong>Publish</strong>.</li></ol><p>Your new theme is now live on your storefront.</p><h2>Step 7: Final Checks</h2><p>After publishing, check:</p><ul><li>&nbsp;Homepage loads correctly on desktop and mobile</li><li>&nbsp;Menus and navigation links work</li><li>&nbsp;Product pages display images and pricing properly</li><li>&nbsp;Cart and checkout flow works end-to-end</li><li>&nbsp;Contact/about pages (if included) show correct content</li></ul>","width":"100%","max_width":"normal","alignment":"left","type_preset":"custom","font":"var(--font-subheading--family)","font_size":"1.125rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","text_color":"","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":12,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_VdG98J"]},"accordion_row_pLFDcD":{"type":"_accordion-row","settings":{"heading":"Design","open_by_default":false,"icon":"none","width":20},"blocks":{"text_qLGEN9":{"type":"text","settings":{"text":"<p><strong>Typography<br/></strong><br/>Bold, condensed uppercase display type pairs with a classic serif logotype for a high-contrast, editorial feel. Body copy uses a clean sans-serif for readability against large-format imagery.</p><p>Color Palette<br/><br/>Strictly monochrome — black, white, and grey only — reinforcing a distinct brand identity rather than relying on decorative color. Built for merchants who want a bold, gallery-like aesthetic.</p><p><strong>Homepage Layout</strong></p><ul><li>Full-bleed hero banner with overlay text and dual CTAs (primary + outline button)</li><li>Scrolling announcement/marquee bar for shipping, returns, and drop announcements</li><li>Stat/spec highlight blocks to visually communicate brand values (e.g. fabric weight, product specs)</li><li>Category quick-links with live product counts</li><li>Editorial split-image sections for lookbook-style storytelling</li></ul><p><strong>Product Discovery</strong><br/><br/>Grid and split-layout options for showcasing collections editorially rather than as a plain catalog — suited to fashion, apparel, and lifestyle brands.</p><p><strong>Cart & Checkout</strong><br/><br/>Slide-out cart drawer with a real-time free-shipping progress bar to encourage higher order values. Clean, distraction-free checkout flow.</p><p><strong>Contact & Trust</strong><br/><br/>Dedicated contact page with form, embedded map, and clear response-time messaging to build trust for direct-to-consumer brands.</p><p><strong>Mobile Experience</strong><br/><br/>Fully responsive with a mobile-first navigation pattern (hamburger menu, condensed header), tested across product, cart, and contact flows.</p><p><strong>Best Suited For</strong><br/><br/>Fashion, apparel, accessories, and lifestyle brands wanting a bold, editorial, minimal-color storefront that stands out from templated multi-color themes.</p>","width":"100%","max_width":"normal","alignment":"left","type_preset":"custom","font":"var(--font-subheading--family)","font_size":"1.125rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","text_color":"","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":12,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_qLGEN9"]}},"block_order":["accordion_row_NdBezV","accordion_row_iJM37V","accordion_row_pLFDcD"]},"disclosures_hFEnPD":{"type":"disclosures","name":"t:names.disclosures","settings":{"heading":"Disclosures","heading_preset":"h5","open_by_default":false,"icon":"caret","disclosure_heading_preset":"h5","text_color":"","dividers":true,"divider_color":"{{ settings.color_palette.color2 }}","padding-block-start":16,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_9WaLn7","price_a7krng","divider_HrJgFt","variant_picker_R3r