{%- comment -%}
  Accepts: product, show_sizes (bool), quick_add (bool)
{%- endcomment -%}
{%- assign is_new = false -%}
{%- if product.tags contains 'new' -%}{%- assign is_new = true -%}{%- endif -%}
<div class="bw-product-card" data-product-card>
  <div class="bw-media-placeholder bw-product-card__media bw-product-card__media--photo" style="position:relative">
    <a href="{{ product.url }}" style="position:absolute;inset:0">
      {%- if product.featured_image -%}
        <img
          src="{{ product.featured_image | image_url: width: 600 }}"
          srcset="{{ product.featured_image | image_url: width: 300 }} 300w, {{ product.featured_image | image_url: width: 450 }} 450w, {{ product.featured_image | image_url: width: 600 }} 600w, {{ product.featured_image | image_url: width: 900 }} 900w"
          sizes="(max-width: 749px) 50vw, 30vw"
          width="{{ product.featured_image.width }}"
          height="{{ product.featured_image.height }}"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          loading="lazy"
        >
        {%- if product.images.size > 1 -%}
          <img
            src="{{ product.images[1] | image_url: width: 600 }}"
            srcset="{{ product.images[1] | image_url: width: 300 }} 300w, {{ product.images[1] | image_url: width: 450 }} 450w, {{ product.images[1] | image_url: width: 600 }} 600w"
            sizes="(max-width: 749px) 50vw, 30vw"
            width="{{ product.images[1].width }}"
            height="{{ product.images[1].height }}"
            alt=""
            loading="lazy"
            aria-hidden="true"
          >
        {%- endif -%}
      {%- else -%}
        {{ product.title | slice: 0, 1 }}
      {%- endif -%}
    </a>
    {%- comment -%}
      compare_at_price_max is the highest across every variant, so a product
      with one marked-down variant still earns the badge. Only a compare-at
      above the selling price is a real markdown.
    {%- endcomment -%}
    {%- if product.compare_at_price_max > product.price_min -%}
      <span class="bw-badge bw-badge--sale">{{ 'products.product.on_sale' | t }}</span>
    {%- elsif is_new -%}
      <span class="bw-badge">New</span>
    {%- elsif product.available == false -%}
      <span class="bw-badge bw-badge--sold">{{ 'products.product.sold_out' | t }}</span>
    {%- endif -%}
    {%- if quick_add -%}
      <button type="button" class="bw-product-card__quickadd" data-quick-add data-variant-id="{{ product.selected_or_first_available_variant.id }}" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
        {%- if product.selected_or_first_available_variant.available -%}{{ 'products.product.quick_add' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
      </button>
    {%- endif -%}
  </div>
  <a href="{{ product.url }}" class="bw-product-card__body">
    <span class="bw-product-card__title">{{ product.title }}</span>
    <span class="bw-product-card__prices">
      {%- comment -%}
        A product whose variants are priced differently has to advertise a
        range, or the cheapest variant reads as the price of all of them.
      {%- endcomment -%}
      <span class="bw-price">
        {%- if product.price_varies -%}
          {{ 'products.product.price_from' | t: price: product.price_min | money_without_trailing_zeros }}
        {%- else -%}
          {{ product.price | money_without_trailing_zeros }}
        {%- endif -%}
      </span>
      {%- if product.compare_at_price_max > product.price_min -%}
        <s class="bw-price-compare">{{ product.compare_at_price_max | money_without_trailing_zeros }}</s>
      {%- endif -%}
      {%- if product.selected_or_first_available_variant.unit_price_measurement -%}
        {%- assign unit_variant = product.selected_or_first_available_variant -%}
        <span class="bw-price-unit">{{ unit_variant.unit_price | money }} / {% if unit_variant.unit_price_measurement.reference_value != 1 %}{{ unit_variant.unit_price_measurement.reference_value }} {% endif %}{{ unit_variant.unit_price_measurement.reference_unit }}</span>
      {%- endif -%}
    </span>
  </a>
  {%- if show_sizes -%}
    <div class="bw-product-card__sizes">
      {%- for variant in product.variants limit: 4 -%}
        <span class="bw-size-chip{% if variant.selected %} is-selected{% endif %}{% unless variant.available %} is-disabled{% endunless %}">{{ variant.title | split: ' / ' | last }}</span>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
