<div class="bw-search-overlay" data-search-overlay aria-hidden="true">
  <form action="{{ routes.search_url }}" method="get" role="search" class="bw-search-overlay__bar">
    <a href="{{ routes.root_url }}" class="bw-header__logo" style="color:#fff">{{ shop.name | default: 'B/W' }}</a>
    <div class="bw-search-overlay__input-wrap">
      <label class="bw-visually-hidden" for="SearchOverlayInput">{{ 'general.search.placeholder' | t }}</label>
      <input id="SearchOverlayInput" type="search" name="q" class="bw-search-overlay__input" placeholder="Search products" autocomplete="off" data-search-input value="{{ search.terms | escape }}">
      <span class="bw-search-overlay__meta" data-search-meta>{{ 'general.search.esc_to_close' | t }}</span>
    </div>
    <input type="hidden" name="type" value="product">
    <button type="button" data-search-close class="bw-visually-hidden">Close</button>
  </form>

  <div class="bw-search-overlay__body">
    <div class="bw-search-overlay__aside">
      {%- if linklists['search-suggestions'].links.size > 0 -%}
        <div class="bw-label-mono" style="margin-bottom:10px">{{ 'general.search.suggestions' | t }}</div>
        <div style="display:flex;flex-direction:column;gap:9px;font:600 13px var(--font-ui);text-transform:uppercase">
          {%- for link in linklists['search-suggestions'].links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if collections.size > 0 -%}
        <div class="bw-label-mono" style="margin:22px 0 10px">{{ 'general.search.collections' | t }}</div>
        <div style="display:flex;flex-direction:column;gap:9px;font:600 13px var(--font-ui);text-transform:uppercase">
          {%- for collection in collections limit: 3 -%}
            <a href="{{ collection.url }}">{{ collection.title }}</a>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="bw-label-mono" style="margin:22px 0 10px">{{ 'general.search.recent' | t }}</div>
      <div style="display:flex;flex-wrap:wrap;gap:6px" data-search-recent></div>
    </div>

    <div class="bw-search-overlay__results" data-search-results>
      <div class="bw-label-mono" style="margin-bottom:14px">{{ 'general.search.products' | t }}</div>
      <div style="display:flex;flex-direction:column;gap:1px;background:var(--grey-20)" data-search-results-list></div>
      <div style="text-align:center;padding:16px">
        <a href="{{ routes.search_url }}?q={{ search.terms | escape }}&type=product" class="bw-nav-link" style="border-bottom:2px solid #000" data-search-view-all>{{ 'general.search.view_all' | t: count: 0 }}</a>
      </div>
    </div>
  </div>
</div>
