{%- comment -%}JSON-LD for rich results: Product, BlogPosting, Organization and a breadcrumb trail.{%- endcomment -%}
{%- if request.page_type == 'product' -%}
{%- assign v = product.selected_or_first_available_variant -%}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Product","name":{{ product.title | json }},"url":{{ shop.url | append: product.url | json }},"description":{{ product.description | strip_html | truncate: 500 | json }},"sku":{{ v.sku | default: v.id | json }},"brand":{"@type":"Brand","name":{{ product.vendor | json }}}{% if product.featured_media %},"image":[{{ product.featured_media.preview_image | image_url: width: 1200 | prepend: 'https:' | json }}]{% endif %},"offers":{"@type":"Offer","url":{{ shop.url | append: product.url | json }},"price":{{ v.price | divided_by: 100.0 | json }},"priceCurrency":{{ cart.currency.iso_code | json }},"availability":"https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}","itemCondition":"https://schema.org/NewCondition"}}</script>
{%- elsif request.page_type == 'article' -%}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BlogPosting","headline":{{ article.title | json }},"datePublished":{{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},"author":{"@type":"Person","name":{{ article.author | json }}},"publisher":{"@type":"Organization","name":{{ shop.name | json }}}{% if article.image %},"image":[{{ article.image | image_url: width: 1200 | prepend: 'https:' | json }}]{% endif %},"mainEntityOfPage":{"@type":"WebPage","@id":{{ shop.url | append: article.url | json }}}}</script>
{%- elsif request.page_type == 'index' -%}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":{{ shop.name | json }},"url":{{ shop.url | json }}{% if settings.logo %},"logo":{{ settings.logo | image_url: width: 500 | prepend: 'https:' | json }}{% endif %}}</script>
{%- endif -%}

{%- if request.page_type == 'product' -%}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":{{ shop.url | json }}},{"@type":"ListItem","position":2,"name":{{ product.title | json }},"item":{{ shop.url | append: product.url | json }}}]}</script>
{%- elsif request.page_type == 'collection' -%}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":{{ shop.url | json }}},{"@type":"ListItem","position":2,"name":{{ collection.title | json }},"item":{{ shop.url | append: collection.url | json }}}]}</script>
{%- elsif request.page_type == 'article' -%}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":{{ shop.url | json }}},{"@type":"ListItem","position":2,"name":{{ blog.title | json }},"item":{{ shop.url | append: blog.url | json }}},{"@type":"ListItem","position":3,"name":{{ article.title | json }},"item":{{ shop.url | append: article.url | json }}}]}</script>
{%- elsif request.page_type == 'page' -%}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":{{ shop.url | json }}},{"@type":"ListItem","position":2,"name":{{ page.title | json }},"item":{{ shop.url | append: page.url | json }}}]}</script>
{%- endif -%}
